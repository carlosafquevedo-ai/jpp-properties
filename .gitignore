# Dependências e builds
node_modules/
dist/
.astro/
.wrangler/

# Variáveis de ambiente (nunca fazer commit de chaves)
.env
.env.*
!.env.example
.dev.vars

# Migração e backups: podem conter dados do cliente
migration-output/
backups/

# Sistema e editores
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
.claude/settings.local.json

# Client source files (originals); only the trimmed logos in public/brand are committed
jpp_logos/

# Local-only demo portraits (watermarked stock images, shown to the client; never commit)
public/team-demo/
