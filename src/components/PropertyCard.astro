---
import Icon from './Icon.astro';
import {
  formatPerSqm,
  formatPrice,
  logoImage,
  propertyTypeLabels,
  zones,
  type Property,
} from '../data/properties';
import { AMI } from '../lib/site';

interface Props {
  property: Property;
  /** Adds data attributes used by the client-side listing filters. */
  filterable?: boolean;
  eager?: boolean;
  /** Photo proportion (Tailwind aspect class). Varied on the home page for the staggered layout. */
  aspect?: string;
}

const MAX_SLIDES = 6;

const { property: p, filterable = false, eager = false, aspect = 'aspect-[4/3]' } = Astro.props;
const href = `/imoveis/${p.slug}/`;
const place = [p.locality, zones[p.zone].name].filter(Boolean).join(', ');
const slides = p.images.slice(0, MAX_SLIDES);
const perSqm = p.usableArea > 0 ? Math.round(p.price / p.usableArea) : 0;
const beds = `${p.bedrooms} ${p.bedrooms === 1 ? 'quarto' : 'quartos'}`;
const filterAttrs = filterable
  ? {
      'data-card': '',
      'data-listing': p.listingType,
      'data-zone': p.zone,
      'data-ptype': p.propertyType,
      'data-beds': p.bedrooms,
      'data-price': p.price,
      'data-condition': p.condition,
      'data-ref': (p.reference ?? '').toLowerCase(),
      'data-added': p.addedAt,
    }
  : {};
---

<article class="property-card group relative flex h-full flex-col" {...filterAttrs}>
  <div
    class:list={['relative z-10 overflow-hidden bg-paper-2', aspect]}
    data-carousel
    data-href={href}
  >
    <div class="card-scroller flex size-full snap-x snap-mandatory overflow-x-auto">
      {slides.map((src, i) => (
        <img
          src={src}
          alt={i === 0 ? `${p.title}, ${place}` : ''}
          class="size-full shrink-0 snap-center object-cover"
          loading={eager && i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          draggable="false"
          referrerpolicy="no-referrer"
        />
      ))}
    </div>

    <span class="card-go" aria-hidden="true">
      <Icon name="arrowUpRight" class="size-4" />
    </span>

    <span class="card-count">
      <Icon name="images" class="size-4" />
      {p.images.length}
      <span class="sr-only">fotografias</span>
    </span>

    {(p.condition === 'new' || p.listingType === 'rent') && (
      <span class="pointer-events-none absolute bottom-3 left-3 flex gap-1.5">
        {p.listingType === 'rent' && <span class="card-tag bg-white">Arrendar</span>}
        {p.condition === 'new' && <span class="card-tag bg-lime">Novo</span>}
      </span>
    )}

    {slides.length > 1 && (
      <>
        <button type="button" class="card-arrow left-3" data-prev aria-label="Fotografia anterior">
          <Icon name="chevronLeft" class="size-5" />
        </button>
        <button type="button" class="card-arrow right-3" data-next aria-label="Fotografia seguinte">
          <Icon name="chevronRight" class="size-5" />
        </button>
        <div class="card-dots" aria-hidden="true">
          {slides.map((_, i) => (
            <span class="card-dot" data-dot={i} data-active={i === 0 ? '' : undefined} />
          ))}
        </div>
      </>
    )}
  </div>

  <div class="flex flex-1 flex-col px-5 pb-5 pt-4">
    <div class="flex items-baseline gap-x-3">
      <p class="whitespace-nowrap font-display text-2xl font-semibold leading-none text-forest">
        {formatPrice(p.price)}
      </p>
      {perSqm > 0 && <p class="whitespace-nowrap text-sm text-muted">{formatPerSqm(perSqm)}</p>}
    </div>
    <h3 class="mt-3 line-clamp-2 min-h-[2.75rem] text-base font-semibold leading-snug">
      <a
        href={href}
        class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-offset-4"
      >
        {p.title}
      </a>
    </h3>
    <p class="mt-1 flex items-baseline justify-between gap-3 text-sm text-muted">
      <span class="truncate">{place}</span>
      {p.reference && <span class="shrink-0 text-xs">Ref. {p.reference}</span>}
    </p>
    <p class="mt-2 truncate text-sm text-ink/85">
      {propertyTypeLabels[p.propertyType]} - {beds} - {p.usableArea} m²
    </p>
    <div class="mt-5 flex items-center gap-3 border-t border-line pt-4 [margin-top:auto]">
      <img src={logoImage} alt="" class="h-6 w-auto" width="72" height="24" loading="lazy" />
      <p class="text-xs leading-tight text-muted">
        JPP Properties
        <br />
        AMI {AMI}
      </p>
    </div>
  </div>
</article>

<script>
  // Photo carousel inside each card: swipe (touch), arrows (mouse) and dots.
  // Clicking the photo opens the listing; the arrows and dots never do.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((box) => {
    const scroller = box.querySelector<HTMLElement>('.card-scroller');
    const dots = [...box.querySelectorAll<HTMLElement>('[data-dot]')];
    if (!scroller) return;
    const width = () => scroller.clientWidth || 1;
    const current = () => Math.round(scroller.scrollLeft / width());
    const go = (n: number) => {
      const last = Math.max(dots.length - 1, 0);
      const i = Math.min(Math.max(n, 0), last);
      scroller.scrollTo({ left: i * width(), behavior: 'smooth' });
    };
    const paint = () => {
      const i = current();
      dots.forEach((d, k) => d.toggleAttribute('data-active', k === i));
    };
    scroller.addEventListener('scroll', paint, { passive: true });
    box.querySelector('[data-prev]')?.addEventListener('click', (e) => {
      e.preventDefault();
      go(current() - 1);
    });
    box.querySelector('[data-next]')?.addEventListener('click', (e) => {
      e.preventDefault();
      go(current() + 1);
    });

    // A tap or click on the photo (not a swipe) opens the listing.
    let startX = 0;
    scroller.addEventListener('pointerdown', (e) => (startX = e.clientX));
    scroller.addEventListener('click', (e) => {
      if (Math.abs(e.clientX - startX) > 6) return;
      const href = box.dataset.href;
      if (href) window.location.assign(href);
    });
  });
</script>
