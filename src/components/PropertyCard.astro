---
import Icon from './Icon.astro';
import { formatPrice, zones, type Property } from '../data/properties';

interface Props {
  property: Property;
  /** Adds data attributes used by the client-side listing filters. */
  filterable?: boolean;
  eager?: boolean;
}

const { property: p, filterable = false, eager = false } = Astro.props;
const href = `/imoveis/${p.slug}/`;
const place = [p.locality, zones[p.zone].name].filter(Boolean).join(', ');
const filterAttrs = filterable
  ? {
      'data-card': '',
      'data-listing': p.listingType,
      'data-zone': p.zone,
      'data-ptype': p.propertyType,
      'data-beds': p.bedrooms,
      'data-price': p.price,
      'data-condition': p.condition,
      'data-ref': (p.reference ?? '').toLowerCase(),
      'data-added': p.addedAt,
    }
  : {};
---

<article class="group relative" {...filterAttrs}>
  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-paper-2">
    <img
      src={p.images[0]}
      alt={`${p.title}, ${place}`}
      class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy="no-referrer"
    />
    <div class="absolute left-3 top-3 flex gap-2">
      <span class="rounded-full bg-paper px-3 py-1 text-xs font-semibold text-forest">
        {p.listingType === 'sale' ? 'Comprar' : 'Arrendar'}
      </span>
      {p.condition === 'new' && (
        <span class="rounded-full bg-lime px-3 py-1 text-xs font-semibold text-forest">Novo</span>
      )}
    </div>
  </div>

  <button
    type="button"
    data-fav={p.slug}
    aria-pressed="false"
    aria-label={`Guardar ${p.title} nos favoritos`}
    class="absolute right-3 top-3 z-10 grid size-11 cursor-pointer place-items-center rounded-full bg-paper/95 text-forest transition-colors hover:bg-white"
  >
    <Icon name="heart" class="size-5" />
  </button>

  <div class="mt-4 flex items-baseline justify-between gap-4">
    <p class="font-display text-2xl leading-none text-forest">{formatPrice(p.price)}</p>
    {p.reference && <p class="text-xs text-muted">Ref. {p.reference}</p>}
  </div>
  <h3 class="mt-2 text-[1.05rem] font-semibold leading-snug">
    <a
      href={href}
      class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-offset-8"
    >
      {p.title}
    </a>
  </h3>
  <p class="mt-1 flex items-center gap-1.5 text-sm text-muted">
    <Icon name="pin" class="size-4" />
    {place}
  </p>
  <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink/80">
    <li class="flex items-center gap-1.5">
      <Icon name="bed" class="size-4 text-olive" /> {p.bedrooms}{' '}
      <span class="sr-only">quartos</span>
    </li>
    <li class="flex items-center gap-1.5">
      <Icon name="bath" class="size-4 text-olive" /> {p.bathrooms}{' '}
      <span class="sr-only">casas de banho</span>
    </li>
    <li class="flex items-center gap-1.5">
      <Icon name="car" class="size-4 text-olive" /> {p.garageSpaces}{' '}
      <span class="sr-only">lugares de garagem</span>
    </li>
    <li class="flex items-center gap-1.5">
      <Icon name="area" class="size-4 text-olive" /> {p.usableArea} m²
    </li>
  </ul>
</article>
