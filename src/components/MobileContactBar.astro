---
import Icon from './Icon.astro';
import { mainPhone, whatsappUrl } from '../lib/site';
---

<nav
  aria-label="Contacto rápido"
  class="on-dark fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 gap-px border-t border-white/10 bg-white/10 lg:hidden"
>
  <a
    href={`tel:${mainPhone.tel}`}
    class="flex min-h-14 items-center justify-center gap-2 bg-forest text-sm font-semibold text-white"
  >
    <Icon name="phone" class="size-5 text-lime" /> Ligar
  </a>
  <a
    href={whatsappUrl}
    rel="noopener"
    class="flex min-h-14 items-center justify-center gap-2 bg-forest text-sm font-semibold text-white"
  >
    <Icon name="whatsapp" class="size-5 text-lime" /> WhatsApp
  </a>
  <a
    href="/#vender"
    class="flex min-h-14 items-center justify-center gap-2 bg-lime text-sm font-semibold text-forest"
  >
    <Icon name="mail" class="size-5" /> Mensagem
  </a>
</nav>
