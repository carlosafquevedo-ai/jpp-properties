---
import Icon from './Icon.astro';
import { logoWhiteImage } from '../data/properties';
import { AMI, facebookUrl, instagramUrl, complaintsBookUrl } from '../lib/site';

// Slim footer: brand, site links, legal links and social. Address, phones and e-mail live in the "Visite-nos" band
// just above it (ContactBand, shown on every page by SiteLayout), so they are not repeated here.
const year = new Date().getFullYear();

const siteLinks = [
  { label: 'Imóveis', href: '/imoveis/' },
  { label: 'Zonas', href: '/#zonas' },
  { label: 'Vender o seu imóvel', href: '/#vender' },
  { label: 'Contactos', href: '#contactos' },
];
const legalLinks = [
  { label: 'Política de Privacidade', href: '/politica-de-privacidade/' },
  { label: 'Resolução de Litígios', href: '/resolucao-de-litigios/' },
  { label: 'Livro de Reclamações', href: complaintsBookUrl, external: true },
];
---

<footer class="on-dark mt-24 bg-forest text-white/80">
  <div class="container-x grid grid-cols-2 gap-x-6 gap-y-10 py-14 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div class="col-span-2 lg:col-span-1">
      <img
        src={logoWhiteImage}
        alt="JPP Properties"
        class="h-12 w-auto"
        width="143"
        height="48"
        loading="lazy"
      />
      <p class="mt-5 max-w-xs text-sm leading-relaxed">
        Mediação imobiliária no Algarve. Vilamoura, Quarteira, Vilasol, Vale do Lobo e Quinta do
        Lago.
      </p>
      <div class="mt-5 flex gap-2">
        <a
          href={facebookUrl}
          class="grid size-10 place-items-center rounded-full border border-white/15 text-white transition-colors hover:border-lime hover:text-lime"
          rel="noopener"
          target="_blank"
          aria-label="Facebook"
        >
          <Icon name="facebook" class="size-4" />
        </a>
        <a
          href={instagramUrl}
          class="grid size-10 place-items-center rounded-full border border-white/15 text-white transition-colors hover:border-lime hover:text-lime"
          rel="noopener"
          target="_blank"
          aria-label="Instagram"
        >
          <Icon name="instagram" class="size-4" />
        </a>
      </div>
    </div>

    <nav aria-label="Navegação">
      <h3 class="font-display text-lg text-white">Navegação</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {siteLinks.map((l) => (
          <li>
            <a href={l.href} class="hover:text-lime">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Informação legal">
      <h3 class="font-display text-lg text-white">Informação legal</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {legalLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class="hover:text-lime"
              {...(l.external ? { rel: 'noopener', target: '_blank' } : {})}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <p class="container-x py-5 text-xs text-white/55">
      © {year} JPP Properties · Mediação imobiliária · AMI {AMI}
    </p>
  </div>
</footer>
