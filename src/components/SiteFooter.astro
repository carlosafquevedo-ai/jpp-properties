---
import Icon from './Icon.astro';
import { AMI, facebookUrl, instagramUrl, complaintsBookUrl } from '../lib/site';

// Beam wordmark footer: the charcoal closing section crossed by a slow diagonal shaft of lime light, with the
// brand set as a giant, bottom-cropped wordmark the light runs through. Ported from a React component to plain
// Astro + a small script (no React dependency). Address, phones and e-mail are not listed here: "Contactos" opens
// the header's "Fale connosco" panel (without JS it goes to the contacts in "Somos daqui" on the home page).
const year = new Date().getFullYear();
const wordmark = 'JPP Properties';

const socials = [
  { label: 'Facebook', href: facebookUrl, icon: 'facebook' as const },
  { label: 'Instagram', href: instagramUrl, icon: 'instagram' as const },
];
const columns = [
  {
    title: 'Navegação',
    links: [
      { label: 'Imóveis', href: '/imoveis/' },
      { label: 'Zonas', href: '/#zonas' },
      { label: 'Vender o seu imóvel', href: '/#vender' },
      { label: 'Carreiras', href: '/carreiras/' },
      { label: 'Contactos', href: '/#sobre', infoPanel: true },
    ],
  },
  {
    title: 'Informação legal',
    links: [
      { label: 'Política de Privacidade', href: '/politica-de-privacidade/' },
      { label: 'Resolução de Litígios', href: '/resolucao-de-litigios/' },
      { label: 'Livro de Reclamações', href: complaintsBookUrl, external: true },
    ],
  },
];

// Staggered reveal: each item rises a little after the one before.
let d = 0;
const delay = () => `--bwf-d:${(d += 70)}ms`;
---

<footer class="bwf on-dark" data-in="false">
  <div class="bwf-rule" aria-hidden="true"></div>
  <div class="bwf-sky" aria-hidden="true">
    <div class="bwf-wash"></div>
    <div class="bwf-bands"></div>
    <div class="bwf-beam"></div>
    <div class="bwf-glow"></div>
    <div class="bwf-grain"></div>
  </div>

  <div class="bwf-inner container-x">
    <div class="bwf-col">
      <p class="bwf-label" style={delay()}>© {year} JPP Properties</p>
      <ul class="bwf-socials">
        {socials.map((s) => (
          <li class="bwf-fade" style={delay()}>
            <a class="bwf-soc" href={s.href} aria-label={s.label} rel="noopener" target="_blank">
              <Icon name={s.icon} class="size-4" />
              <span class="bwf-tip" aria-hidden="true">{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="bwf-credits">
        <p class="bwf-fade" style={delay()}>
          Mediação imobiliária no Algarve. Vilamoura, Quarteira, Vilasol, Vale do Lobo e Quinta do Lago.
        </p>
        <p class="bwf-fade" style={delay()}>
          Licença <b>AMI {AMI}</b>
        </p>
      </div>
    </div>

    {columns.map((col) => (
      <nav class="bwf-col" aria-label={col.title}>
        <p class="bwf-label" style={delay()}>{col.title}</p>
        <ul class="bwf-links">
          {col.links.map((l) => (
            <li class="bwf-fade" style={delay()}>
              <a
                class="bwf-link"
                href={l.href}
                {...('external' in l && l.external ? { rel: 'noopener', target: '_blank' } : {})}
                {...('infoPanel' in l && l.infoPanel ? { 'data-info-open': '', 'aria-haspopup': 'dialog' } : {})}
              >
                <span class="bwf-link-t">{l.label}</span>
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path
                    d="M2.5 9.5l7-7M4 2.5h5.5V8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="bwf-word">
    <p class="sr-only">{wordmark}</p>
    <div class="bwf-word-box container-x">
      <div class="bwf-word-in" aria-hidden="true">
        {Array.from(wordmark).map((ch, i) => (
          <span class="bwf-lw" style={`--bwf-d:${260 + i * 75}ms`}>
            <span class="bwf-l">{ch === ' ' ? ' ' : ch}</span>
          </span>
        ))}
      </div>
    </div>
    <div class="bwf-foot" aria-hidden="true"></div>
  </div>
</footer>

<script>
  // Pure helpers: fitting and beam maths.
  const clamp = (v: number, lo: number, hi: number) => (v < lo ? lo : v > hi ? hi : v);
  // Font size (px) that makes a word measured at 100px span `target` px, capped so a short word stays low.
  const fitSize = (at100: number, target: number, cap: number) =>
    at100 > 0 && target > 0 ? Math.min((100 * target) / at100, cap) : 0;
  // Beam position (% across) for a pointer at u (0 → 1 across).
  const beamTarget = (u: number) => 30 + 52 * clamp(u, 0, 1);
  // Idle sway: two slow, unrelated sines so it never visibly loops.
  const drift = (t: number) => 58 + 9 * (0.7 * Math.sin(t * 0.21) + 0.3 * Math.sin(t * 0.077 + 1.3));
  // Frame-rate independent ease: k is the fraction closed per 1/60s.
  const approach = (from: number, to: number, k: number, dt: number) =>
    to + (from - to) * Math.pow(1 - k, clamp(dt, 0, 0.1) * 60);
  // Baseline in a line-height:1 box, as a fraction of the font size, read off a canvas.
  const measureBaseline = (font: string, text: string) => {
    try {
      const ctx = document.createElement('canvas').getContext('2d');
      if (!ctx) return 0.8;
      ctx.font = font;
      const m = ctx.measureText(text);
      const a = m.fontBoundingBoxAscent;
      const de = m.fontBoundingBoxDescent;
      if (!(a > 0) || !(de >= 0)) return 0.8;
      return clamp(((100 - a - de) / 2 + a) / 100, 0.5, 1.2);
    } catch {
      return 0.8;
    }
  };
  // Where the bottom edge cuts the wordmark, in em below its baseline.
  const CUT = 0.14;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('.bwf').forEach((root) => {
    const word = root.querySelector<HTMLElement>('.bwf-word')!;
    const box = root.querySelector<HTMLElement>('.bwf-word-box')!;
    const inner = root.querySelector<HTMLElement>('.bwf-word-in')!;
    const letters = Array.from(inner.querySelectorAll<HTMLElement>('.bwf-l'));
    const text = letters.map((l) => l.textContent).join('');
    const set = (k: string, v: string) => root.style.setProperty(k, v);

    // Tell every letter where it sits inside the footer, so its slice of the beam lines up with the backdrop.
    // offsetLeft/Top chains ignore the reveal translate, so the beam is aligned while letters are still rising.
    const place = () => {
      set('--bwf-rw', root.offsetWidth + 'px');
      set('--bwf-rh', root.offsetHeight + 'px');
      let top = 0;
      letters.forEach((s, i) => {
        let x = 0;
        let y = 0;
        let el: HTMLElement | null = s;
        while (el && el !== root) {
          x += el.offsetLeft;
          y += el.offsetTop;
          el = el.offsetParent as HTMLElement | null;
        }
        s.style.setProperty('--bwf-x', x + 'px');
        s.style.setProperty('--bwf-y', y + 'px');
        if (i === 0) top = y;
      });
      set('--bwf-top', top + 'px');
      set('--bwf-bot', top + (parseFloat(inner.style.fontSize) || 0) * 0.92 + 'px');
    };

    // Fit the wordmark to the page width, then crop it just below the baseline.
    const fit = () => {
      const cs = getComputedStyle(box);
      const target = box.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      inner.style.fontSize = '100px';
      const measured = inner.offsetWidth;
      const ics = getComputedStyle(inner);
      const base = measureBaseline(`${ics.fontWeight} 100px ${ics.fontFamily}`, text);
      const size = fitSize(measured, target, target * 0.42);
      inner.style.fontSize = size + 'px';
      word.style.height = Math.max(0, size * (base + CUT)) + 'px';
      place();
    };

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(fit);
    };
    fit();
    new ResizeObserver(schedule).observe(root);
    document.fonts?.ready.then(schedule);

    // Pointer state reaches the page as CSS variables.
    const ptr = { u: 0.5, x: 0, y: 0, inside: false };
    const onPointer = (e: PointerEvent) => {
      const r = root.getBoundingClientRect();
      ptr.x = e.clientX - r.left;
      ptr.y = e.clientY - r.top;
      ptr.u = r.width ? ptr.x / r.width : 0.5;
      ptr.inside = e.type !== 'pointerleave';
    };
    root.addEventListener('pointermove', onPointer);
    root.addEventListener('pointerenter', onPointer);
    root.addEventListener('pointerleave', onPointer);

    const paint = (b: number, px: number, py: number, g: number) => {
      set('--bwf-b', b.toFixed(2) + '%');
      set('--bwf-px', px.toFixed(1) + 'px');
      set('--bwf-py', py.toFixed(1) + 'px');
      set('--bwf-g', g.toFixed(3));
    };

    // The beam runs only while the footer is on screen; with reduced motion it holds still and the glow just
    // follows the pointer.
    let raf = 0;
    let last = 0;
    let t = performance.now() / 1000;
    let b = 58;
    let px = 0;
    let py = 0;
    let g = 0;
    const tick = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      if (reduced.matches) {
        paint(58, ptr.x, ptr.y, ptr.inside ? 1 : 0);
      } else {
        t += dt;
        const idle = drift(t);
        b = approach(b, ptr.inside ? beamTarget(ptr.u) * 0.75 + idle * 0.25 : idle, 0.035, dt);
        px = approach(px, ptr.x, 0.16, dt);
        py = approach(py, ptr.y, 0.16, dt);
        g = approach(g, ptr.inside ? 1 : 0, 0.06, dt);
        paint(b, px, py, g);
      }
      raf = requestAnimationFrame(tick);
    };

    // Reveal once, the first time the footer is seen.
    new IntersectionObserver(
      ([e]) => {
        cancelAnimationFrame(raf);
        if (!e.isIntersecting) return;
        root.dataset.in = 'true';
        last = performance.now();
        raf = requestAnimationFrame(tick);
      },
      { threshold: 0.12 },
    ).observe(root);

    // Letters hop when clicked.
    letters.forEach((l) => {
      l.addEventListener('click', () => {
        if (reduced.matches) return;
        l.classList.remove('is-hop');
        void l.offsetWidth;
        l.classList.add('is-hop');
      });
      l.addEventListener('animationend', () => l.classList.remove('is-hop'));
    });
  });
</script>

<style>
  /* Palette: deep olive ground (the green atmosphere's base, so the page closes in the same palette), lime beam and
     labels, olive wordmark sinking into the dark. */
  .bwf {
    --bwf-bg: var(--g-900, #1a2414);
    --bwf-bg-rgb: 26, 36, 20;
    --bwf-ink: #fff;
    --bwf-ink-rgb: 255, 255, 255;
    --bwf-muted: rgba(255, 255, 255, 0.6);
    --bwf-acc: 158, 188, 58;
    --bwf-wt: var(--color-olive);
    --bwf-wf: #20251a;
    --bwf-ang: 118deg;
    --bwf-b: 58%;
    --bwf-px: 50%;
    --bwf-py: 50%;
    --bwf-g: 0;
    --bwf-top: 0px;
    --bwf-bot: 100%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    container-type: inline-size;
    background: var(--bwf-bg);
    color: var(--bwf-ink);
    -webkit-font-smoothing: antialiased;
    touch-action: pan-y;
  }
  .bwf a {
    color: inherit;
    text-decoration: none;
  }
  .bwf ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Top hairline, brighter where the beam crosses it. */
  .bwf-rule {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    z-index: 3;
    background: linear-gradient(
      90deg,
      rgba(var(--bwf-acc), 0.15),
      rgba(var(--bwf-acc), 0.55) var(--bwf-b),
      rgba(var(--bwf-acc), 0.15)
    );
  }

  /* Backdrop: wash, faint vertical bands, the beam, the pointer glow, grain. */
  .bwf-sky,
  .bwf-sky > div {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .bwf-sky {
    z-index: 0;
  }
  .bwf-wash {
    background:
      radial-gradient(120% 90% at 8% 0%, rgba(var(--bwf-acc), 0.14), transparent 55%),
      radial-gradient(90% 70% at 92% 8%, rgba(var(--bwf-acc), 0.09), transparent 60%),
      linear-gradient(180deg, rgba(var(--bwf-acc), 0.04), transparent 70%);
  }
  .bwf-bands {
    background: repeating-linear-gradient(
      90deg,
      rgba(var(--bwf-acc), 0.04) 0 1.6cqw,
      transparent 1.6cqw 4.2cqw
    );
    mask-image: linear-gradient(100deg, #000 0%, transparent 55%);
  }
  .bwf-beam {
    filter: blur(calc(1px + 1.6cqw));
    background:
      linear-gradient(
        var(--bwf-ang),
        transparent calc(var(--bwf-b) - 11%),
        rgba(var(--bwf-acc), 0.08) calc(var(--bwf-b) - 5%),
        rgba(var(--bwf-acc), 0.26) var(--bwf-b),
        rgba(var(--bwf-acc), 0.06) calc(var(--bwf-b) + 4%),
        transparent calc(var(--bwf-b) + 9%)
      ),
      linear-gradient(
        var(--bwf-ang),
        transparent calc(var(--bwf-b) - 34%),
        rgba(var(--bwf-acc), 0.08) calc(var(--bwf-b) - 27%),
        transparent calc(var(--bwf-b) - 20%)
      );
  }
  .bwf-glow {
    opacity: var(--bwf-g);
    background: radial-gradient(
      circle 26cqw at var(--bwf-px) var(--bwf-py),
      rgba(var(--bwf-acc), 0.12),
      transparent 70%
    );
  }
  .bwf-grain {
    opacity: 0.14;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  /* Layout. */
  .bwf-inner {
    position: relative;
    z-index: 2;
    padding-top: clamp(3rem, 7cqw, 6rem);
    display: grid;
    grid-template-columns: minmax(0, 1.62fr) minmax(0, 0.86fr) minmax(0, 0.86fr);
    column-gap: clamp(1.5rem, 4cqw, 3rem);
    row-gap: 2.75rem;
  }
  .bwf-col {
    min-width: 0;
  }
  .bwf-col:first-child {
    max-width: 26rem;
  }
  .bwf-label {
    position: relative;
    display: block;
    padding-bottom: 0.8rem;
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--bwf-acc));
  }
  .bwf-label::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(var(--bwf-acc), 0.55), rgba(var(--bwf-acc), 0.2));
    transform-origin: 0 50%;
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.1, 1) var(--bwf-d, 0ms);
  }
  .bwf[data-in='false'] .bwf-label::after {
    transform: scaleX(0);
  }
  .bwf-fade {
    transition:
      opacity 0.9s ease var(--bwf-d, 0ms),
      translate 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) var(--bwf-d, 0ms);
  }
  .bwf[data-in='false'] .bwf-fade {
    opacity: 0;
    translate: 0 14px;
  }

  /* Socials: glassy squares with a lit top edge. */
  .bwf-socials {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.85rem;
  }
  .bwf-soc {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-sm);
    color: rgba(var(--bwf-ink-rgb), 0.7);
    background: linear-gradient(180deg, rgba(var(--bwf-ink-rgb), 0.09), rgba(var(--bwf-ink-rgb), 0.025));
    box-shadow:
      inset 0 0 0 1px rgba(var(--bwf-ink-rgb), 0.16),
      inset 0 1px 0 rgba(var(--bwf-ink-rgb), 0.14),
      0 6px 14px -8px rgba(27, 30, 28, 0.8);
    transition:
      color 0.25s,
      box-shadow 0.35s,
      translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      background 0.35s;
  }
  .bwf-soc:hover,
  .bwf-soc:focus-visible {
    color: #fff;
    translate: 0 -2px;
    background: linear-gradient(180deg, rgba(var(--bwf-acc), 0.32), rgba(var(--bwf-acc), 0.08));
    box-shadow:
      inset 0 0 0 1px rgba(var(--bwf-acc), 0.75),
      inset 0 1px 0 rgba(var(--bwf-ink-rgb), 0.3),
      0 10px 26px -8px rgba(var(--bwf-acc), 0.6);
  }
  .bwf-tip {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: calc(100% + 9px);
    translate: -50% -4px;
    white-space: nowrap;
    font-size: 0.6875rem;
    line-height: 1;
    padding: 6px 8px;
    border-radius: 4px;
    background: rgb(var(--bwf-acc));
    color: var(--color-ink);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s,
      translate 0.25s;
  }
  .bwf-tip::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 100%;
    margin-left: -4px;
    border: 4px solid transparent;
    border-bottom-color: rgb(var(--bwf-acc));
  }
  .bwf-soc:hover .bwf-tip,
  .bwf-soc:focus-visible .bwf-tip {
    opacity: 1;
    translate: -50% 0;
  }

  /* Description and AMI. */
  .bwf-credits {
    margin-top: 1.3rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--bwf-muted);
  }
  .bwf-credits p + p {
    margin-top: 0.4rem;
  }
  .bwf-credits b {
    font-weight: 400;
    color: var(--bwf-ink);
  }

  /* Link columns: a lime tick and arrow slide in on hover. */
  .bwf-links {
    margin-top: 0.8rem;
    display: flex;
    flex-direction: column;
  }
  .bwf-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0;
    font-size: 0.9rem;
    line-height: 1.3;
    color: rgba(var(--bwf-ink-rgb), 0.78);
    transition: color 0.25s;
  }
  .bwf-link-t {
    transition: translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .bwf-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 6px;
    height: 1px;
    background: rgb(var(--bwf-acc));
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .bwf-link svg {
    width: 12px;
    height: 12px;
    opacity: 0;
    translate: -6px 0;
    color: rgb(var(--bwf-acc));
    transition:
      opacity 0.25s,
      translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .bwf-link:hover,
  .bwf-link:focus-visible {
    color: #fff;
  }
  .bwf-link:hover::before,
  .bwf-link:focus-visible::before {
    transform: scaleX(1);
  }
  .bwf-link:hover .bwf-link-t,
  .bwf-link:focus-visible .bwf-link-t {
    translate: 12px 0;
  }
  .bwf-link:hover svg,
  .bwf-link:focus-visible svg {
    opacity: 1;
    translate: 18px 0;
  }

  /* The wordmark. Each letter paints the footer-sized background shifted back by its own offset, so the beam
     and glow line up with the backdrop. Height is set by the script (fallback before it runs). */
  .bwf-word {
    position: relative;
    z-index: 1;
    overflow: hidden;
    height: 20cqw;
    margin-top: clamp(1.75rem, 6cqw, 5rem);
  }
  .bwf-word-in {
    display: inline-flex;
    white-space: nowrap;
    font-size: 15cqw;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    user-select: none;
  }
  .bwf-lw {
    display: inline-block;
    transition: translate 1.25s cubic-bezier(0.16, 0.84, 0.2, 1) var(--bwf-d, 0ms);
  }
  .bwf[data-in='false'] .bwf-lw {
    translate: 0 85%;
  }
  .bwf-l {
    display: inline-block;
    cursor: pointer;
    color: transparent;
    -webkit-background-clip: text;
    background-clip: text;
    background-repeat: no-repeat;
    background-size: var(--bwf-rw) var(--bwf-rh);
    background-position: calc(var(--bwf-x) * -1) calc(var(--bwf-y) * -1);
    background-image:
      radial-gradient(
        circle 22cqw at var(--bwf-px) var(--bwf-py),
        rgba(var(--bwf-acc), calc(var(--bwf-g) * 0.85)),
        transparent 70%
      ),
      linear-gradient(
        var(--bwf-ang),
        transparent calc(var(--bwf-b) - 9%),
        rgba(var(--bwf-acc), 0.55) calc(var(--bwf-b) - 1.5%),
        rgba(var(--bwf-acc), 0.7) var(--bwf-b),
        rgba(var(--bwf-acc), 0.2) calc(var(--bwf-b) + 3.5%),
        transparent calc(var(--bwf-b) + 8%)
      ),
      linear-gradient(180deg, var(--bwf-wt) var(--bwf-top), var(--bwf-wf) var(--bwf-bot));
    transform-origin: 50% 100%;
    transition:
      transform 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.2),
      filter 0.4s;
  }
  .bwf-l:hover {
    transform: translateY(-0.045em);
    filter: brightness(1.35) saturate(1.1);
  }
  .bwf-l:global(.is-hop) {
    animation: bwf-hop 0.75s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes bwf-hop {
    0% {
      transform: translateY(0) scale(1, 1);
    }
    18% {
