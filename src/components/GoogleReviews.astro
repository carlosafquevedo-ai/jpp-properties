---
import Icon from './Icon.astro';
import { googleProfileUrl } from '../lib/site';

/**
 * Google reviews. Nothing here is invented: the rating, the count and the reviews come from /api/reviews
 * (Pages Function, Google Places API, see functions/api/reviews.ts). Until that is configured (or if Google fails)
 * only the heading and the button to the Google profile are shown.
 */
---

<section
  id="avaliacoes"
  class="container-x reviews"
  aria-labelledby="avaliacoes-titulo"
  data-reviews
  data-endpoint="/api/reviews"
>
  <div class="reviews-grid">
    <div class="reviews-intro">
      <h2 id="avaliacoes-titulo" class="font-display text-3xl text-forest sm:text-4xl">
        O que dizem de nós
      </h2>
      <div class="reviews-summary" data-summary hidden>
        <span class="reviews-score" data-score></span>
        <span class="reviews-stars" data-summary-stars aria-hidden="true"></span>
        <span class="reviews-count" data-count></span>
      </div>
      <p class="reviews-lead" data-lead>
        Veja o que os clientes dizem da JPP Properties no Google.
      </p>
      <a href={googleProfileUrl} class="btn btn-dark" target="_blank" rel="noopener">
        Ver todas no Google <Icon name="arrowUpRight" class="size-4" />
      </a>
    </div>
    <div class="reviews-board" data-board hidden>
      <ul class="reviews-list" data-list aria-label="Avaliações no Google"></ul>
      <div class="reviews-nav">
        <button type="button" class="feat-nav" data-prev aria-label="Avaliações anteriores">
          <Icon name="chevronLeft" class="size-5" />
        </button>
        <button type="button" class="feat-nav" data-next aria-label="Avaliações seguintes">
          <Icon name="chevronRight" class="size-5" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  interface Review {
    author: string;
    authorUrl: string | null;
    rating: number;
    when: string;
    text: string;
  }
  interface Payload {
    rating: number | null;
    count: number | null;
    reviews: Review[];
  }

  const root = document.querySelector<HTMLElement>('[data-reviews]');
  if (root) {
    const NS = 'http://www.w3.org/2000/svg';
    const star = (filled: boolean) => {
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('aria-hidden', 'true');
      svg.setAttribute('class', filled ? 'rv-star is-on' : 'rv-star');
      const path = document.createElementNS(NS, 'path');
      path.setAttribute(
        'd',
        'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z',
      );
      svg.append(path);
      return svg;
    };
    const fillStars = (el: HTMLElement, value: number) => {
      el.replaceChildren(...[1, 2, 3, 4, 5].map((i) => star(value >= i - 0.25)));
    };

    const load = async () => {
      const res = await fetch(root.dataset.endpoint ?? '/api/reviews', {
        headers: { accept: 'application/json' },
      });
      if (!res.ok) return;
      const data = (await res.json()) as Payload;

      const summary = root.querySelector<HTMLElement>('[data-summary]');
      if (data.rating && summary) {
        const score = root.querySelector<HTMLElement>('[data-score]');
        const stars = root.querySelector<HTMLElement>('[data-summary-stars]');
        const count = root.querySelector<HTMLElement>('[data-count]');
        if (score)
          score.textContent = data.rating.toLocaleString('pt-PT', { minimumFractionDigits: 1 });
        if (stars) fillStars(stars, data.rating);
        if (count && data.count) count.textContent = `${data.count} avaliações no Google`;
        summary.hidden = false;
        root.querySelector<HTMLElement>('[data-lead]')?.setAttribute('hidden', '');
      }

      const list = root.querySelector<HTMLElement>('[data-list]');
      const board = root.querySelector<HTMLElement>('[data-board]');
      if (!list || !board || !data.reviews?.length) return;
      list.replaceChildren(
        ...data.reviews.map((r) => {
          const li = document.createElement('li');
          li.className = 'rv-card';
          const stars = document.createElement('span');
          stars.className = 'reviews-stars';
          stars.setAttribute('role', 'img');
          stars.setAttribute('aria-label', `${r.rating} em 5 estrelas`);
          fillStars(stars, r.rating);
          const text = document.createElement('p');
          text.className = 'rv-text';
          text.textContent = r.text;
          const foot = document.createElement('div');
          foot.className = 'rv-foot';
          const name = document.createElement(r.authorUrl ? 'a' : 'span');
          name.className = 'rv-author';
          name.textContent = r.author;
          if (r.authorUrl && name instanceof HTMLAnchorElement) {
            name.href = r.authorUrl;
            name.target = '_blank';
            name.rel = 'noopener';
          }
          const when = document.createElement('span');
          when.className = 'rv-when';
          when.textContent = r.when;
          foot.append(name, when);
          li.append(stars, text, foot);
          return li;
        }),
      );
      board.hidden = false;
      root.classList.add('has-reviews');

      const step = () => {
        const card = list.querySelector<HTMLElement>('.rv-card');
        return card ? card.offsetWidth + 16 : list.clientWidth;
      };
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');
      const nav = root.querySelector<HTMLElement>('.reviews-nav');
      const sync = () => {
        const max = list.scrollWidth - list.clientWidth;
        if (nav) nav.hidden = max <= 4;
        if (prev) prev.disabled = list.scrollLeft <= 2;
        if (next) next.disabled = list.scrollLeft >= max - 2;
      };
      prev?.addEventListener('click', () => list.scrollBy({ left: -step(), behavior: 'smooth' }));
      next?.addEventListener('click', () => list.scrollBy({ left: step(), behavior: 'smooth' }));
      list.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    };
    load().catch(() => {
      /* leave the heading and the Google button only */
    });
  }
</script>
