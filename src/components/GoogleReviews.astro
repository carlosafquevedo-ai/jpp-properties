---
import Icon from './Icon.astro';
import { googleProfileUrl } from '../lib/site';

/**
 * Google reviews. Nothing here is invented: the rating, the count and the reviews come from /api/reviews
 * (Pages Function, Google Places API, see functions/api/reviews.ts). Until that is configured (or if Google fails)
 * only the heading and the button to the Google profile are shown.
 */

// TODO: DEMO ONLY. Example reviews shown while /api/reviews is not configured, so the client can see the layout.
// They are NOT real reviews and nothing on screen says so: remove this demo data before launch (once the Google Places key is set).
const demoReviews = [
  {
    author: 'Maria S.',
    authorUrl: null,
    rating: 5,
    when: 'há 2 semanas',
    text: 'Acompanharam-nos em todos os passos da compra do nosso apartamento. Sempre disponíveis, claros nas explicações e atentos a cada detalhe. Recomendo sem hesitar.',
  },
  {
    author: 'João P.',
    authorUrl: null,
    rating: 5,
    when: 'há um mês',
    text: 'Vendemos a nossa casa em poucas semanas. A avaliação foi realista, as fotografias ficaram excelentes e a comunicação foi sempre rápida. Profissionais de confiança.',
  },
  {
    author: 'Sophie L.',
    authorUrl: null,
    rating: 5,
    when: 'há 2 meses',
    text: 'Great team who really know the Algarve. They showed us several properties that matched exactly what we were looking for and helped with every step until the deed.',
  },
  {
    author: 'Carlos M.',
    authorUrl: null,
    rating: 4,
    when: 'há 3 meses',
    text: 'Bom acompanhamento e muito conhecimento da zona de Vilamoura. O processo foi tranquilo e fomos sempre informados do ponto da situação.',
  },
  {
    author: 'Ana R.',
    authorUrl: null,
    rating: 5,
    when: 'há 4 meses',
    text: 'Encontraram o arrendamento ideal para a nossa família. Atenciosos, simpáticos e muito profissionais. Voltaremos a contar com eles.',
  },
];
---

<section
  id="avaliacoes"
  class="container-x reviews"
  aria-labelledby="avaliacoes-titulo"
  data-reviews
  data-endpoint="/api/reviews"
  data-demo={JSON.stringify({ rating: 4.8, count: null, reviews: demoReviews })}
>
  <div class="reviews-grid">
    <div class="reviews-intro">
      <h2 id="avaliacoes-titulo" class="zones-title">
        O que dizem de nós
      </h2>
      <div class="reviews-summary" data-summary hidden>
        <span class="reviews-score" data-score></span>
        <span class="reviews-stars" data-summary-stars aria-hidden="true"></span>
        <span class="reviews-count" data-count></span>
      </div>
      <p class="reviews-lead" data-lead>
        Veja o que os clientes dizem da JPP Properties no Google.
      </p>
      <a href={googleProfileUrl} class="btn btn-dark" target="_blank" rel="noopener">
        Ver todas no Google <Icon name="arrowUpRight" class="size-4" />
      </a>
    </div>
    <div class="reviews-board" data-board hidden>
      <ul class="reviews-list" data-list aria-label="Avaliações no Google"></ul>
      <div class="reviews-nav">
        <button type="button" class="feat-nav" data-prev aria-label="Avaliações anteriores">
          <Icon name="chevronLeft" class="size-5" />
        </button>
        <button type="button" class="feat-nav" data-next aria-label="Avaliações seguintes">
          <Icon name="chevronRight" class="size-5" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  interface Review {
    author: string;
    authorUrl: string | null;
    photo?: string | null;
    rating: number;
    when: string;
    text: string;
  }
  interface Payload {
    rating: number | null;
    count: number | null;
    reviews: Review[];
  }

  const root = document.querySelector<HTMLElement>('[data-reviews]');
  if (root) {
    const NS = 'http://www.w3.org/2000/svg';
    const star = (filled: boolean) => {
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('aria-hidden', 'true');
      svg.setAttribute('class', filled ? 'rv-star is-on' : 'rv-star');
      const path = document.createElementNS(NS, 'path');
      path.setAttribute(
        'd',
        'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z',
      );
      svg.append(path);
      return svg;
    };
    const fillStars = (el: HTMLElement, value: number) => {
      el.replaceChildren(...[1, 2, 3, 4, 5].map((i) => star(value >= i - 0.25)));
    };

    const fetchReal = async (): Promise<Payload | null> => {
      const res = await fetch(root.dataset.endpoint ?? '/api/reviews', {
        headers: { accept: 'application/json' },
      });
      if (!res.ok) return null;
      const data = (await res.json()) as Payload;
      return data.reviews?.length ? data : null;
    };

    const load = async () => {
      let data = await fetchReal().catch(() => null);
      if (!data && root.dataset.demo) {
        data = JSON.parse(root.dataset.demo) as Payload;
      }
      if (!data) return;

      const summary = root.querySelector<HTMLElement>('[data-summary]');
      if (data.rating && summary) {
        const score = root.querySelector<HTMLElement>('[data-score]');
        const stars = root.querySelector<HTMLElement>('[data-summary-stars]');
        const count = root.querySelector<HTMLElement>('[data-count]');
        if (score)
          score.textContent = data.rating.toLocaleString('pt-PT', { minimumFractionDigits: 1 });
        if (stars) fillStars(stars, data.rating);
        if (count && data.count) count.textContent = `${data.count} avaliações no Google`;
        summary.hidden = false;
        root.querySelector<HTMLElement>('[data-lead]')?.setAttribute('hidden', '');
      }

      const list = root.querySelector<HTMLElement>('[data-list]');
      const board = root.querySelector<HTMLElement>('[data-board]');
      if (!list || !board || !data.reviews?.length) return;
      // The site's dark greens (--g-700 … --g-400), so the avatars stay inside the palette.
      const palette = ['#2e4114', '#3a5215', '#4b6a1a', '#526f1f'];
      const colorFor = (name: string) =>
        palette[[...name].reduce((n, c) => n + c.charCodeAt(0), 0) % palette.length];
      const googleG = () => {
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('viewBox', '0 0 48 48');
        svg.setAttribute('class', 'rv-g');
        svg.setAttribute('aria-hidden', 'true');
        [
          [
            '#EA4335',
            'M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z',
          ],
          [
            '#4285F4',
            'M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z',
          ],
          [
            '#FBBC05',
            'M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z',
          ],
          [
            '#34A853',
            'M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z',
          ],
        ].forEach(([fill, d]) => {
          const path = document.createElementNS(NS, 'path');
          path.setAttribute('fill', fill!);
          path.setAttribute('d', d!);
          svg.append(path);
        });
        return svg;
      };
      list.replaceChildren(
        ...data.reviews.map((r) => {
          const li = document.createElement('li');
          li.className = 'rv-card';

          const head = document.createElement('div');
          head.className = 'rv-head';
          const avatar = document.createElement('span');
          avatar.className = 'rv-avatar';
          avatar.style.background = colorFor(r.author);
          avatar.textContent = r.author.trim().charAt(0).toUpperCase();
          if (r.photo) {
            const img = document.createElement('img');
            img.src = r.photo;
            img.alt = '';
            img.loading = 'lazy';
            img.referrerPolicy = 'no-referrer';
            img.addEventListener('error', () => img.remove());
            avatar.append(img);
          }
          const who = document.createElement('div');
          who.className = 'rv-who';
          const name = document.createElement(r.authorUrl ? 'a' : 'span');
          name.className = 'rv-author';
          name.textContent = r.author;
          if (r.authorUrl && name instanceof HTMLAnchorElement) {
            name.href = r.authorUrl;
            name.target = '_blank';
            name.rel = 'noopener';
          }
          who.append(name);
          head.append(avatar, who, googleG());

          const meta = document.createElement('div');
          meta.className = 'rv-meta';
          const stars = document.createElement('span');
          stars.className = 'reviews-stars rv-stars';
          stars.setAttribute('role', 'img');
          stars.setAttribute('aria-label', `${r.rating} em 5 estrelas`);
          fillStars(stars, r.rating);
          const when = document.createElement('span');
          when.className = 'rv-when';
          when.textContent = r.when;
          meta.append(stars, when);

          const text = document.createElement('p');
          text.className = 'rv-text';
          text.textContent = r.text;
          li.append(head, meta, text);

          // "Ler mais" only when the text is actually cut.
          requestAnimationFrame(() => {
            if (text.scrollHeight > text.clientHeight + 2) {
              const more = document.createElement('button');
              more.type = 'button';
              more.className = 'rv-more';
              more.textContent = 'Ler mais';
              more.addEventListener('click', () => {
                const open = li.classList.toggle('is-open');
                more.textContent = open ? 'Ler menos' : 'Ler mais';
              });
              li.append(more);
            }
          });
          return li;
        }),
      );
      board.hidden = false;
      root.classList.add('has-reviews');

      const step = () => {
        const card = list.querySelector<HTMLElement>('.rv-card');
        return card ? card.offsetWidth + 16 : list.clientWidth;
      };
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');
      const nav = root.querySelector<HTMLElement>('.reviews-nav');
      const sync = () => {
        const max = list.scrollWidth - list.clientWidth;
        if (nav) nav.hidden = max <= 4;
        if (prev) prev.disabled = list.scrollLeft <= 2;
        if (next) next.disabled = list.scrollLeft >= max - 2;
      };
      prev?.addEventListener('click', () => list.scrollBy({ left: -step(), behavior: 'smooth' }));
      next?.addEventListener('click', () => list.scrollBy({ left: step(), behavior: 'smooth' }));
      list.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    };
    load().catch(() => {
      /* leave the heading and the Google button only */
    });
  }
</script>
