---
import { alternateLinks, type Locale, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  route: RouteKey;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
const links = alternateLinks(route);
---

<nav aria-label={t('lang.switch')}>
  <ul class="flex gap-3 text-sm">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          hreflang={link.locale}
          lang={link.locale}
          aria-current={link.locale === locale ? 'true' : undefined}
          class:list={[
            'uppercase tracking-wide hover:text-olive-700',
            link.locale === locale ? 'font-semibold text-olive-700' : 'text-ink/70',
          ]}
        >
          {link.locale}
        </a>
      </li>
    ))}
  </ul>
</nav>
