export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  filled?: boolean;
}

// Brand glyphs are solid shapes; the rest are outline icons.
const solid = new Set<IconName>(['whatsapp']);
const { name, class: className = 'size-5', filled = false } = Astro.props;
const isSolid = filled || solid.has(name);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill={isSolid ? 'currentColor' : 'none'}
  stroke={solid.has(name) ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={icons[name]}
/>
