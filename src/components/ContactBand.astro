---
import Icon from './Icon.astro';
import { email, offices, openingHours, whatsappUrl } from '../lib/site';

// "Visite-nos": the last call to action before the footer. Everything comes from the site settings (offices, phones,
// e-mail, WhatsApp, hours); in production from Sanity's siteSettings. No embedded map (it would set Google cookies
// before consent): "Como chegar" opens the office in Google Maps instead.
// TODO: provisional copy (PT); EN/FR pending. Opening hours are hidden until the client confirms them.
const office = offices[0]!;
const [mainPhone] = office.phones;
---

<section id="contactos" class="container-x contact-band" aria-labelledby="contactos-titulo">
  <div class="contact-head">
    <div>
      <h2 id="contactos-titulo" class="zones-title">
        Visite-nos em {office.name}
      </h2>
      <p class="contact-lead">
        Passe pelo escritório ou fale connosco por telefone, WhatsApp ou email.
      </p>
    </div>
    <div class="contact-actions">
      {mainPhone && (
        <a href={`tel:${mainPhone.tel}`} class="btn btn-dark">
          <Icon name="phone" class="size-4" /> Ligar agora
        </a>
      )}
      <a href={whatsappUrl} class="btn btn-lime" target="_blank" rel="noopener">
        <Icon name="whatsapp" class="size-4" /> WhatsApp
      </a>
    </div>
  </div>

  <dl class="contact-details">
    <div>
      <dt>Morada</dt>
      <dd>
        <address>
          {office.address.map((line) => (
            <span class="block">{line}</span>
          ))}
        </address>
        <a href={office.mapUrl} class="contact-map" target="_blank" rel="noopener">
          Como chegar <Icon name="arrowUpRight" class="size-4" />
        </a>
      </dd>
    </div>
    <div>
      <dt>Telefones</dt>
      <dd>
        <ul>
          {office.phones.map((p) => (
            <li>
              <a href={`tel:${p.tel}`}>{p.label}</a>
              <span class="contact-note">({p.note})</span>
            </li>
          ))}
        </ul>
      </dd>
    </div>
    <div>
      <dt>Email</dt>
      <dd>
        <a href={`mailto:${email}`}>{email}</a>
      </dd>
      {openingHours.length > 0 && (
        <>
          <dt class="mt-6">Horário</dt>
          <dd>
            {openingHours.map((line) => (
              <span class="block">{line}</span>
            ))}
          </dd>
        </>
      )}
    </div>
  </dl>
</section>
