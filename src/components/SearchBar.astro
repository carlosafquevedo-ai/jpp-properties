---
import Icon from './Icon.astro';
import { getSearchOptions, getPriceRange } from '../lib/search-options';

const { zoneOptions, typeOptions, bedroomOptions } = getSearchOptions();
const price = getPriceRange();
---

<form action="/imoveis/" method="get">
  <fieldset class="glass-seg mb-3">
    <legend class="sr-only">Tipo de negócio</legend>
    <label class="cursor-pointer">
      <input type="radio" name="tipo" value="comprar" class="peer sr-only" checked />
      <span class="glass-seg-opt">Comprar</span>
    </label>
    <label class="cursor-pointer">
      <input type="radio" name="tipo" value="arrendar" class="peer sr-only" />
      <span class="glass-seg-opt">Arrendar</span>
    </label>
  </fieldset>

  <div class="grid grid-cols-2 gap-x-3 gap-y-1 sm:grid-cols-3 lg:grid-cols-[1.1fr_1.1fr_0.9fr_1.4fr_auto] lg:gap-x-3 lg:items-center">
    <div class="glass-field col-span-2 sm:col-span-1">
      <label for="s-zona">Zona</label>
      <select id="s-zona" name="zona" class="glass-select">
        <option value="">Todas as zonas</option>
        {zoneOptions.map((o) => (
          <option value={o.value}>{o.label}</option>
        ))}
      </select>
    </div>
    <div class="glass-field">
      <label for="s-imovel">Tipo de imóvel</label>
      <select id="s-imovel" name="imovel" class="glass-select">
        <option value="">Todos os tipos</option>
        {typeOptions.map((o) => (
          <option value={o.value}>{o.label}</option>
        ))}
      </select>
    </div>
    <div class="glass-field">
      <label for="s-quartos">Quartos</label>
      <select id="s-quartos" name="quartos" class="glass-select">
        <option value="">Qualquer</option>
        {bedroomOptions.map((o) => (
          <option value={o.value}>{o.label}</option>
        ))}
      </select>
    </div>
    <div
      class="glass-field glass-range col-span-2 sm:col-span-2 lg:col-span-1"
      data-range
      data-min={price.min}
      data-max={price.max}
    >
      <div class="glass-range-head">
        <label for="s-preco">Preço máximo</label>
        <output for="s-preco" class="glass-range-value">
          Sem limite
        </output>
      </div>
      <input
        id="s-preco"
        class="glass-slider"
        type="range"
        min="0"
        max="1000"
        step="1"
        value="1000"
        autocomplete="off"
      />
      <input type="hidden" name="precoMax" value="" disabled />
    </div>
    <button
      type="submit"
      class="btn btn-dark self-stretch lg:min-h-0 col-span-2 sm:col-span-1 lg:col-span-1"
    >
      <Icon name="search" class="size-5" />
      <span>Pesquisar</span>
    </button>
  </div>
</form>
<script>
  // Custom option list for mouse users (the native one can't be styled). Touch devices keep the
  // native <select>, which is the best experience there. The real <select> stays in the form.
  const CHECK =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="glass-check"><path d="M20 6 9 17l-5-5"/></svg>';

  const enhance = (select: HTMLSelectElement) => {
    const field = select.closest<HTMLElement>('.glass-field');
    const label = field?.querySelector('label');
    if (!field || !label) return;

    const uid = select.id;
    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.id = `${uid}-btn`;
    trigger.className = 'glass-select glass-trigger';
    trigger.setAttribute('aria-haspopup', 'listbox');
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-controls', `${uid}-list`);
    label.setAttribute('for', trigger.id);

    const list = document.createElement('ul');
    list.id = `${uid}-list`;
    list.className = 'glass-list';
    list.setAttribute('role', 'listbox');
    list.setAttribute('aria-labelledby', label.id || (label.id = `${uid}-label`));
    list.tabIndex = -1;
    list.hidden = true;

    const options = [...select.options].map((o, i) => {
      const li = document.createElement('li');
      li.id = `${uid}-opt-${i}`;
      li.className = 'glass-opt';
      li.setAttribute('role', 'option');
      li.dataset.index = String(i);
      li.innerHTML = `<span>${o.text}</span>${CHECK}`;
      list.append(li);
      return li;
    });

    select.classList.add('sr-only');
    select.tabIndex = -1;
    select.setAttribute('aria-hidden', 'true');
    field.append(trigger, list);

    let active = select.selectedIndex;
    let typed = '';
    let typedTimer = 0;

    const paint = () => {
      trigger.textContent = select.options[select.selectedIndex]?.text ?? '';
      options.forEach((li, i) => {
        li.setAttribute('aria-selected', String(i === select.selectedIndex));
        li.toggleAttribute('data-active', i === active);
      });
      list.setAttribute('aria-activedescendant', options[active]?.id ?? '');
    };
    const setActive = (i: number) => {
      active = (i + options.length) % options.length;
      paint();
      options[active].scrollIntoView({ block: 'nearest' });
    };
    const open = () => {
      if (!list.hidden) return;
      document.querySelectorAll<HTMLElement>('.glass-list').forEach((l) => (l.hidden = true));
      active = select.selectedIndex;
      list.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      paint();
      list.focus({ preventScroll: true });
      // The list opens downward: bring it fully into view if it runs past the fold.
      const overflow = list.getBoundingClientRect().bottom - window.innerHeight + 24;
      if (overflow > 0) window.scrollBy({ top: overflow, behavior: 'smooth' });
      options[active].scrollIntoView({ block: 'nearest' });
    };
    const close = (refocus = true) => {
      if (list.hidden) return;
      list.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (refocus) trigger.focus({ preventScroll: true });
    };
    const choose = (i: number) => {
      select.selectedIndex = i;
      select.dispatchEvent(new Event('change', { bubbles: true }));
      paint();
      close();
    };

    trigger.addEventListener('click', () => (list.hidden ? open() : close()));
    trigger.addEventListener('keydown', (e) => {
      if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(e.key)) {
        e.preventDefault();
        open();
      }
    });
    list.addEventListener('keydown', (e) => {
      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          setActive(active + 1);
          break;
        case 'ArrowUp':
          e.preventDefault();
          setActive(active - 1);
          break;
        case 'Home':
          e.preventDefault();
          setActive(0);
          break;
        case 'End':
          e.preventDefault();
          setActive(options.length - 1);
          break;
        case 'Enter':
        case ' ':
          e.preventDefault();
          choose(active);
          break;
        case 'Escape':
          e.preventDefault();
          close();
          break;
        case 'Tab':
          close(false);
          break;
        default:
          if (e.key.length === 1) {
            typed += e.key.toLowerCase();
            clearTimeout(typedTimer);
            typedTimer = window.setTimeout(() => (typed = ''), 600);
            const hit = options.findIndex((li) => li.textContent!.toLowerCase().startsWith(typed));
            if (hit >= 0) setActive(hit);
          }
      }
    });
    list.addEventListener('pointermove', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('.glass-opt');
      if (li && Number(li.dataset.index) !== active) {
        active = Number(li.dataset.index);
        paint();
      }
    });
    list.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('.glass-opt');
      if (li) choose(Number(li.dataset.index));
    });
    document.addEventListener('pointerdown', (e) => {
      if (!field.contains(e.target as Node)) close(false);
    });
    select.form?.addEventListener('reset', () => setTimeout(paint));
    paint();
  };

  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLSelectElement>('.glass-field select').forEach(enhance);
  }
</script>

<script>
  // Price slider. Its ends are the cheapest and the dearest listing on the site, so it can never
  // go outside that range, and it always opens at the exact middle.
  const money = new Intl.NumberFormat('pt-PT', {
    style: 'currency',
    currency: 'EUR',
    maximumFractionDigits: 0,
  });
  const MIDDLE = 500; // slider runs 0..1000
  document.querySelectorAll<HTMLElement>('[data-range]').forEach((box) => {
    const min = Number(box.dataset.min);
    const max = Number(box.dataset.max);
    const slider = box.querySelector<HTMLInputElement>('input[type=range]')!;
    const out = box.querySelector<HTMLOutputElement>('output')!;
    const hidden = box.querySelector<HTMLInputElement>('input[type=hidden]')!;

    const priceAt = (v: number) => {
      if (v <= 0) return min;
      if (v >= 1000) return max;
      const raw = min + ((max - min) * v) / 1000;
      return Math.min(max, Math.max(min, Math.round(raw / 500) * 500));
    };
    // The bar opens at the middle as a starting point only. The filter is sent
    // once the person moves it, so nobody gets hidden results by default.
    const update = () => {
      const value = priceAt(Number(slider.value));
      const text = `Até ${money.format(value).replace(/\u00a0/g, ' ')}`;
      out.textContent = text;
      slider.setAttribute('aria-valuetext', text);
      slider.style.setProperty('--pct', `${Number(slider.value) / 10}%`);
      hidden.value = String(value);
    };
    const touch = () => {
      box.setAttribute('data-touched', '');
      hidden.disabled = false;
      update();
    };
    const reset = () => {
      slider.value = String(MIDDLE);
      box.removeAttribute('data-touched');
      hidden.disabled = true;
      update();
    };

    if (min === max) slider.disabled = true; // a single price: nothing to choose
    slider.addEventListener('input', touch);
    slider.form?.addEventListener('reset', () => setTimeout(reset));
    // Always open at the middle, even if the browser restores an old position (back/reload).
    window.addEventListener('pageshow', reset);
    reset();
  });
</script>
