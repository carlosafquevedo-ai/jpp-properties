---
// Round flag for the language switcher (inline SVG, no extra requests).
interface Props {
  locale: 'pt' | 'en' | 'fr';
  class?: string;
}
const { locale, class: className } = Astro.props;
const id = `flag-clip-${locale}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class:list={['flag', className]}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={id}><circle cx="12" cy="12" r="12"></circle></clipPath>
  </defs>
  <g clip-path={`url(#${id})`}>
    {
      locale === 'pt' && (
        <>
          <rect width="24" height="24" fill="#d8232a" />
          <rect width="9.6" height="24" fill="#046a38" />
          <circle cx="9.6" cy="12" r="3.6" fill="#ffd400" />
          <circle cx="9.6" cy="12" r="2.1" fill="#d8232a" />
          <circle cx="9.6" cy="12" r="1.1" fill="#fff" />
        </>
      )
    }
    {
      locale === 'en' && (
        <>
          <rect width="24" height="24" fill="#1c3a8a" />
          <path d="M0 0L24 24M24 0L0 24" stroke="#fff" stroke-width="4.6" />
          <path d="M0 0L24 24M24 0L0 24" stroke="#d8232a" stroke-width="1.8" />
          <path d="M12 0V24M0 12H24" stroke="#fff" stroke-width="7" />
          <path d="M12 0V24M0 12H24" stroke="#d8232a" stroke-width="4" />
        </>
      )
    }
    {
      locale === 'fr' && (
        <>
          <rect width="8" height="24" fill="#1d3f9f" />
          <rect x="8" width="8" height="24" fill="#fff" />
          <rect x="16" width="8" height="24" fill="#e1303a" />
        </>
      )
    }
  </g>
  <circle cx="12" cy="12" r="11.6" fill="none" stroke="rgba(0,0,0,.18)" stroke-width=".8"></circle>
</svg>
