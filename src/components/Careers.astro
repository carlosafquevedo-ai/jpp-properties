---
import Icon from './Icon.astro';

// TODO: provisional copy (PT); EN/FR pending. The photo is the office entrance as a stand-in: replace it with a team
// photo when the client sends one. The button goes to a careers page that does not exist yet (/carreiras/).
const careersUrl = '/carreiras/';
---

<section id="carreiras" class="container-x careers" aria-labelledby="carreiras-titulo">
  <div class="careers-head">
    <h2 id="carreiras-titulo" class="font-display text-3xl text-forest sm:text-4xl">
      Faça carreira connosco
    </h2>
    <p class="mt-4 text-ink/80">
      Procuramos consultores imobiliários que queiram crescer no Algarve, a começar ou com
      experiência.
    </p>
  </div>
  <div class="careers-card">
    <div class="careers-photo">
      <img
        src="/office/escritorio-entrada.webp"
        alt="Entrada do escritório da JPP Properties em Vilamoura"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="careers-body">
      <h3 class="font-display text-2xl text-forest sm:text-3xl">
        Trabalhe com quem conhece a zona
      </h3>
      <p class="mt-4 text-ink/80">
        Quer fazer parte de uma equipa que acompanha clientes da primeira visita à escritura?
        Conte-nos o seu percurso e fale com a JPP Properties.
      </p>
      <a href={careersUrl} class="btn btn-dark mt-6 self-start">
        Quero ser consultor <Icon name="arrowRight" class="size-4" />
      </a>
    </div>
  </div>
</section>
