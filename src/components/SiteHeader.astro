---
import Icon from './Icon.astro';
import { formatPrice, logoImage, zones } from '../data/properties';
import { latestProperty, typesWithListings, zonesWithListings } from '../lib/catalog';
import { locales, localizedPath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { mainPhone } from '../lib/site';

const path = Astro.url.pathname;
const links = [
  { href: '/imoveis/', label: 'Imóveis', match: '/imoveis', mega: true },
  { href: '/#zonas', label: 'Zonas' },
  { href: '/#vender', label: 'Vender' },
  { href: '/#sobre', label: 'Sobre nós' },
  { href: '/#contacto', label: 'Contactos' },
];

// Mega menu content comes from the catalogue, so it grows with the listings.
const megaZones = zonesWithListings();
const megaTypes = typesWithListings();
const newest = latestProperty();
const newestPlace = [newest.locality, zones[newest.zone].name].filter(Boolean).join(', ');

// TODO: EN/FR pages are placeholders for now, so the switcher points to their home pages.
const currentLocale = 'pt';
const t = useTranslations(currentLocale);
const langLinks = locales.map((l) => ({
  l,
  href: localizedPath('home', l),
  name: t(`lang.${l}` as 'lang.pt' | 'lang.en' | 'lang.fr'),
}));
const linkClass =
  'rounded-full px-4 py-2 whitespace-nowrap text-[0.95rem] font-medium text-ink/80 transition-colors hover:bg-paper-2 hover:text-ink aria-[current=page]:bg-paper-2 aria-[current=page]:text-ink';
---

<header class="site-header" id="site-header">
  <div class="hdr-bar">
    <a href="/" aria-label="JPP Properties, página inicial" class="shrink-0">
      <img src={logoImage} alt="JPP Properties" class="h-10 w-auto" width="133" height="40" />
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Principal">
      <ul class="flex items-center gap-1">
        {links.map((l) =>
          l.mega ? (
            <li data-mega-item class="flex items-center">
              <a
                href={l.href}
                aria-current={path.startsWith(l.match) ? 'page' : undefined}
                class:list={[linkClass, '!pr-1']}
              >
                {l.label}
              </a>
              <button
                type="button"
                class="mega-caret"
                aria-expanded="false"
                aria-controls="mega-menu"
                aria-label="Mostrar o menu de imóveis"
              >
                <Icon name="chevronDown" class="size-4" />
              </button>
            </li>
          ) : (
            <li>
              <a href={l.href} class={linkClass}>
                {l.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="relative hidden lg:block" data-lang>
        <button
          type="button"
          class="lang-btn"
          aria-expanded="false"
          aria-controls="lang-menu"
          aria-label={`Idioma: ${langLinks.find((x) => x.l === currentLocale)?.name}`}
        >
          {currentLocale}
          <Icon name="chevronDown" class="lang-caret size-4" />
        </button>
        <ul id="lang-menu" class="lang-menu" hidden>
          {langLinks.map(({ l, href, name }) => (
            <li>
              <a
                href={href}
                hreflang={l}
                lang={l}
                aria-current={l === currentLocale ? 'true' : undefined}
                class="mega-link lang-item"
              >
                <span>{name}</span>
                <Icon name="check" class="lang-check size-4" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <a
        href={`tel:${mainPhone.tel}`}
        class="hidden items-center gap-2 rounded-full px-4 py-2 whitespace-nowrap text-[0.95rem] font-semibold text-ink hover:bg-paper-2 xl:inline-flex"
      >
        <Icon name="phone" class="size-4 text-olive" />
        {mainPhone.label}
      </a>
      <a href="/#contacto" class="btn btn-dark hidden min-h-11 sm:inline-flex">
        Falar connosco
      </a>
      <button
        type="button"
        id="menu-btn"
        class="grid size-11 cursor-pointer place-items-center rounded-full bg-forest text-white lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menu"
      >
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <!-- Mega menu (desktop): zones, property types and the newest listing -->
  <div id="mega-menu" class="hdr-mega" hidden>
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr_1.2fr]">
      <section aria-labelledby="mega-zonas">
        <h2 id="mega-zonas" class="mega-title">
          Zonas
        </h2>
        <ul class="mt-2">
          {megaZones.map((z) => (
            <li>
              <a href={`/imoveis/?zona=${z.id}`} class="mega-link">
                <span>{z.name}</span>
                <span class="mega-count">{z.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="mega-tipos">
        <h2 id="mega-tipos" class="mega-title">
          Tipo de imóvel
        </h2>
        <ul class="mt-2">
          {megaTypes.map((t) => (
            <li>
              <a href={`/imoveis/?imovel=${t.id}`} class="mega-link">
                <span>{t.name}</span>
                <span class="mega-count">{t.count}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/imoveis/" class="btn btn-dark min-h-11 px-4">
            Ver todos os imóveis
          </a>
          <a href="/#contacto" class="btn btn-ghost min-h-11 px-4">
            Pedir um imóvel
          </a>
        </div>
      </section>

      <a href={`/imoveis/${newest.slug}/`} class="mega-card group">
        <span class="block overflow-hidden rounded-xl">
          <img
            src={newest.images[0]}
            alt=""
            class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
            referrerpolicy="no-referrer"
          />
        </span>
        <span class="mt-3 block text-xs font-medium text-muted">Último imóvel adicionado</span>
        <span class="mt-1 block font-display text-lg leading-tight text-forest">
          {newest.title}
        </span>
        <span class="mt-1 flex items-baseline justify-between gap-3 text-sm text-muted">
          <span>{newestPlace}</span>
          <span class="font-semibold text-forest">{formatPrice(newest.price)}</span>
        </span>
      </a>
    </div>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="hdr-panel rounded-3xl border border-line bg-paper p-6 shadow-xl lg:hidden"
  >
    <nav aria-label="Menu móvel">
      <ul class="space-y-1">
        {links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-xl px-2 py-3 font-display text-2xl text-forest">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="mt-3 flex items-center gap-1 text-sm font-semibold" aria-label="Idioma">
      {langLinks.map(({ l, href }) => (
        <a
          href={href}
          hreflang={l}
          lang={l}
          aria-current={l === currentLocale ? 'true' : undefined}
          class="rounded-md px-3 py-2 uppercase tracking-wide text-ink/55 aria-[current=true]:bg-paper-2 aria-[current=true]:text-ink"
        >
          {l}
        </a>
      ))}
    </nav>
    <a href={`tel:${mainPhone.tel}`} class="btn btn-lime mt-4 w-full">
      <Icon name="phone" class="size-5" />
      {mainPhone.label}
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const syncHeader = () => header?.toggleAttribute('data-stuck', window.scrollY > 24);
  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });

  // Mobile menu
  const btn = document.getElementById('menu-btn');
  const panel = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    if (!btn || !panel) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    panel.hidden = !open;
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });

  // Dropdowns (mega menu, language list): open on hover (mouse) and on the button
  // (keyboard/touch); close on Esc, outside click or when focus leaves. Only one is open at a time.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  type Drop = { root: HTMLElement; button: HTMLButtonElement; panel: HTMLElement; timer: number };
  const drops: Drop[] = [];
  const isOpen = (d: Drop) => !d.panel.hidden;
  const open = (d: Drop) => {
    clearTimeout(d.timer);
    drops.filter((o) => o !== d).forEach(close);
    d.panel.hidden = false;
    d.button.setAttribute('aria-expanded', 'true');
  };
  const close = (d: Drop) => {
    clearTimeout(d.timer);
    d.panel.hidden = true;
    d.button.setAttribute('aria-expanded', 'false');
  };
  const closeSoon = (d: Drop) => {
    clearTimeout(d.timer);
    d.timer = window.setTimeout(() => close(d), 180);
  };
  const register = (root: HTMLElement | null, panel: HTMLElement | null) => {
    const button = root?.querySelector<HTMLButtonElement>('button[aria-controls]');
    if (!root || !panel || !button) return;
    const d: Drop = { root, button, panel, timer: 0 };
    drops.push(d);
    root.addEventListener('pointerenter', () => fine.matches && open(d));
    root.addEventListener('pointerleave', () => fine.matches && closeSoon(d));
    panel.addEventListener('pointerenter', () => clearTimeout(d.timer));
    panel.addEventListener('pointerleave', () => fine.matches && closeSoon(d));
    button.addEventListener('click', () => (isOpen(d) ? close(d) : open(d)));
  };
  register(
    document.querySelector<HTMLElement>('[data-mega-item]'),
    document.getElementById('mega-menu'),
  );
  register(
    document.querySelector<HTMLElement>('[data-lang]'),
    document.getElementById('lang-menu'),
  );

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    setOpen(false);
    const d = drops.find(isOpen);
    if (d) {
      close(d);
      d.button.focus();
    }
  });
  header?.addEventListener('focusout', (e) => {
    if (!header.contains((e as FocusEvent).relatedTarget as Node | null)) drops.forEach(close);
  });
  document.addEventListener('pointerdown', (e) => {
    if (header && !header.contains(e.target as Node)) drops.forEach(close);
  });
</script>
