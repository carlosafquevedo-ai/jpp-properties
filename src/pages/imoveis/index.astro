---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import Icon from '../../components/Icon.astro';
import { properties, zones, propertyTypeLabels } from '../../data/properties';
---

<SiteLayout
  title="Imóveis à venda no Algarve | JPP Properties"
  description="Apartamentos e moradias à venda em Vilamoura, Quarteira e Algarve. Filtre por zona, tipo, quartos e preço."
  route="properties"
>
  <div class="container-x pb-8">
    <nav aria-label="Localização" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-ink">
            Início
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">
          Imóveis
        </li>
      </ol>
    </nav>
    <h1 class="mt-3 font-serif text-5xl text-forest sm:text-6xl">Imóveis no Algarve</h1>
  </div>

  <div class="container-x grid items-start gap-8 lg:grid-cols-[17rem_1fr]">
    <!-- Filters -->
    <aside class="lg:sticky lg:top-28">
      <button
        type="button"
        id="filters-toggle"
        class="btn btn-ghost w-full lg:hidden"
        aria-expanded="false"
        aria-controls="filters"
      >
        <Icon name="sliders" class="size-5" /> Filtros
      </button>

      <form
        id="filters"
        class="mt-3 hidden space-y-5 rounded-3xl border border-line bg-white p-5 lg:mt-0 lg:block"
        autocomplete="off"
      >
        <fieldset>
          <legend class="mb-2 text-sm font-semibold">Negócio</legend>
          <div class="grid grid-cols-3 gap-1 rounded-full bg-paper-2 p-1 text-sm font-semibold">
            {[
              ['', 'Todos'],
              ['comprar', 'Comprar'],
              ['arrendar', 'Arrendar'],
            ].map(([v, l]) => (
              <label class="cursor-pointer">
                <input type="radio" name="tipo" value={v} class="peer sr-only" checked={v === ''} />
                <span class="block rounded-full px-2 py-2 text-center text-muted peer-checked:bg-forest peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-olive">
                  {l}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="f-zona" class="mb-1.5 block text-sm font-semibold">
            Zona
          </label>
          <select id="f-zona" name="zona" class="field">
            <option value="">Todas as zonas</option>
            {Object.entries(zones).map(([id, z]) => (
              <option value={id}>{z.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="f-imovel" class="mb-1.5 block text-sm font-semibold">
            Tipo de imóvel
          </label>
          <select id="f-imovel" name="imovel" class="field">
            <option value="">Todos os tipos</option>
            {Object.entries(propertyTypeLabels).map(([id, l]) => (
              <option value={id}>{l}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="f-quartos" class="mb-1.5 block text-sm font-semibold">
            Quartos (mínimo)
          </label>
          <select id="f-quartos" name="quartos" class="field">
            <option value="">Qualquer</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
          </select>
        </div>
        <fieldset>
          <legend class="mb-1.5 text-sm font-semibold">Preço (€)</legend>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="f-pmin" class="sr-only">
                Preço mínimo
              </label>
              <input
                id="f-pmin"
                name="precoMin"
                type="number"
                inputmode="numeric"
                min="0"
                step="10000"
                placeholder="Mín."
                class="field"
              />
            </div>
            <div>
              <label for="f-pmax" class="sr-only">
                Preço máximo
              </label>
              <input
                id="f-pmax"
                name="precoMax"
                type="number"
                inputmode="numeric"
                min="0"
                step="10000"
                placeholder="Máx."
                class="field"
              />
            </div>
          </div>
        </fieldset>
        <div>
          <label for="f-estado" class="mb-1.5 block text-sm font-semibold">
            Estado
          </label>
          <select id="f-estado" name="estado" class="field">
            <option value="">Novo ou usado</option>
            <option value="new">Novo</option>
            <option value="used">Usado</option>
          </select>
        </div>
        <div>
          <label for="f-ref" class="mb-1.5 block text-sm font-semibold">
            Referência
          </label>
          <input id="f-ref" name="ref" type="search" placeholder="Ex.: CRT2" class="field" />
        </div>
        <button
          type="reset"
          id="filters-reset"
          class="w-full cursor-pointer rounded-full py-2 text-sm font-semibold text-olive underline underline-offset-4 hover:text-forest"
        >
          Limpar filtros
        </button>
      </form>
    </aside>

    <!-- Results -->
    <section aria-label="Resultados">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <p id="count" class="font-semibold" role="status" aria-live="polite">
          {properties.length} imóveis
        </p>
        <div class="flex items-center gap-2">
          <label for="f-ordem" class="text-sm text-muted">
            Ordenar por
          </label>
          <select id="f-ordem" name="ordem" form="filters" class="field w-auto py-2">
            <option value="recentes">Mais recentes</option>
            <option value="preco-asc">Preço: do mais baixo</option>
            <option value="preco-desc">Preço: do mais alto</option>
          </select>
        </div>
      </div>

      <div id="grid" class="grid gap-x-6 gap-y-12 sm:grid-cols-2 xl:grid-cols-3">
        {properties.map((p, i) => (
          <PropertyCard property={p} filterable eager={i < 3} />
        ))}
      </div>

      <div id="empty" hidden class="rounded-3xl bg-paper-2 p-10 text-center">
        <h2 class="font-serif text-4xl text-forest">Não encontrámos imóveis com estes filtros</h2>
        <p class="mx-auto mt-3 max-w-md text-ink/80">
          Ajuste os filtros ou diga-nos o que procura. Temos acesso a imóveis que ainda não estão no
          site.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <button type="button" id="empty-reset" class="btn btn-ghost">
            Limpar filtros
          </button>
          <a href="/#contacto" class="btn btn-dark">
            Pedir um imóvel
          </a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  const form = document.getElementById('filters') as HTMLFormElement;
  const order = document.getElementById('f-ordem') as HTMLSelectElement;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const grid = document.getElementById('grid')!;
  const toggle = document.getElementById('filters-toggle')!;

  const listingMap: Record<string, string> = { comprar: 'sale', arrendar: 'rent' };
  const fields = [
    'tipo',
    'zona',
    'imovel',
    'quartos',
    'precoMin',
    'precoMax',
    'estado',
    'ref',
  ] as const;

  const read = () => {
    const data = new FormData(form);
    const v = (k: string) => String(data.get(k) ?? '').trim();
    return Object.fromEntries([...fields.map((k) => [k, v(k)]), ['ordem', order.value]]) as Record<
      string,
      string
    >;
  };

  const apply = () => {
    const f = read();
    let shown = 0;
    const sorted = [...cards].sort((a, b) => {
      if (f.ordem === 'preco-asc') return Number(a.dataset.price) - Number(b.dataset.price);
      if (f.ordem === 'preco-desc') return Number(b.dataset.price) - Number(a.dataset.price);
      return b.dataset.added!.localeCompare(a.dataset.added!);
    });
    sorted.forEach((c, i) => {
      c.style.order = String(i);
      const d = c.dataset;
      const price = Number(d.price);
      const ok =
        (!f.tipo || d.listing === listingMap[f.tipo]) &&
        (!f.zona || d.zone === f.zona) &&
        (!f.imovel || d.ptype === f.imovel) &&
        (!f.quartos || Number(d.beds) >= Number(f.quartos)) &&
        (!f.precoMin || price >= Number(f.precoMin)) &&
        (!f.precoMax || price <= Number(f.precoMax)) &&
        (!f.estado || d.condition === f.estado) &&
        (!f.ref || (d.ref ?? '').includes(f.ref.toLowerCase()));
      c.hidden = !ok;
      if (ok) shown++;
    });
    count.textContent = shown === 1 ? '1 imóvel' : `${shown} imóveis`;
    empty.hidden = shown > 0;
    grid.hidden = shown === 0;

    // Keep the URL shareable: only non-default values are written.
    const params = new URLSearchParams();
    Object.entries(f).forEach(
      ([k, val]) => val && !(k === 'ordem' && val === 'recentes') && params.set(k, val),
    );
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  };

  // Restore state from the URL (also used by the home page search bar).
  const params = new URLSearchParams(location.search);
  fields.forEach((k) => {
    const val = params.get(k);
    if (!val) return;
    const radios = form.querySelectorAll<HTMLInputElement>(`input[type=radio][name=${k}]`);
    if (radios.length) radios.forEach((r) => (r.checked = r.value === val));
    else {
      const el = form.elements.namedItem(k);
      if (el instanceof HTMLSelectElement || el instanceof HTMLInputElement) el.value = val;
    }
  });
  if (params.get('ordem')) order.value = params.get('ordem')!;

  form.addEventListener('input', apply);
  form.addEventListener('change', apply);
  form.addEventListener('reset', () => setTimeout(apply));
  const reset = () => {
    form.reset();
    order.value = 'recentes';
    apply();
  };
  document.getElementById('empty-reset')!.addEventListener('click', reset);

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    form.classList.toggle('hidden', !open);
  });

  apply();
</script>
