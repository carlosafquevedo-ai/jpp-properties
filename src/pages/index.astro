---
import SiteLayout from '../layouts/SiteLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import PropertyCard from '../components/PropertyCard.astro';
import ContactForm from '../components/ContactForm.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import {
  formatPrice,
  logoWhiteImage,
  zones,
  propertyTypeLabels,
  type ZoneId,
} from '../data/properties';
import { featuredProperties, heroSlides } from '../lib/catalog';
import { sideHighlights } from '../data/home';
import { team } from '../data/team';
import { AMI, offices, email } from '../lib/site';

const featured = featuredProperties();
const slides = heroSlides();
const [mainHighlight, ...otherHighlights] = sideHighlights;

// Zone photos used on the tiles. TODO: in production each zone document has its own photo (Sanity).
const zoneImages: Partial<Record<ZoneId, string>> = {
  vilamoura: '/zones/vilamoura.jpg', // TODO: confirm the photo's licence/credit with the client
  loule: '/zones/loule.webp', // TODO: confirm the photo's licence/credit with the client
  'vale-do-lobo': '/zones/vale-do-lobo.jpg', // TODO: confirm the photo's licence/credit with the client
  'quinta-do-lago': '/zones/quinta-do-lago.jpg', // TODO: confirm the photo's licence/credit with the client
  vilasol: '/zones/vilasol.jpg', // TODO: confirm the photo's licence/credit with the client
  quarteira: '/zones/quarteira.jpg', // TODO: confirm the photo's licence/credit with the client
};
// Office photos (one or two). TODO: placeholders; set `src` when the client provides real photos.
const officePhotos: { src?: string; alt: string }[] = [
  { alt: 'Escritório da JPP Properties em Vilamoura' },
  { alt: 'Interior do escritório da JPP Properties' },
];
const aboutZones = (
  ['vilamoura', 'quarteira', 'vilasol', 'vale-do-lobo', 'quinta-do-lago', 'loule'] as ZoneId[]
).map((id) => ({ id, name: zones[id].name }));
const zoneTiles = (Object.keys(zones) as ZoneId[]).map((id) => ({ id, image: zoneImages[id] }));
---

<SiteLayout
  title="JPP Properties | Imóveis no Algarve"
  description="Apartamentos e moradias em Vilamoura, Quarteira, Vale do Lobo e Quinta do Lago. JPP Properties, AMI 9361."
  route="home"
  padTop={false}
>
  <!-- Hero: full-bleed rotating photos, rounded bottom corners and a hanging tab that holds the search box -->
  <section>
    <div class="hero-shape relative isolate z-20 flex min-h-[clamp(680px,86svh,900px)] flex-col justify-end">
      <div class="absolute inset-0 -z-20 overflow-hidden" data-hero-media>
        {slides.map((slide, i) => (
          <img
            src={slide.image}
            alt={slide.alt}
            class:list={['hero-slide size-full object-cover', i === 0 && 'is-active']}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            referrerpolicy="no-referrer"
          />
        ))}
      </div>
      <div class="hero-shade absolute inset-0 -z-10"></div>

      <div class="container-x pb-8 pt-32 text-white lg:flex lg:items-start lg:justify-between lg:gap-10">
        <div class="hero-copy">
          <h1 class="max-w-4xl font-display text-[clamp(2rem,4.2vw,3.5rem)] leading-[1]">
            Encontre a sua casa
            <br />
            no Algarve.
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/90 [@media(max-height:740px)]:hidden">
            Apartamentos e moradias em Vilamoura, Quarteira, Vale do Lobo e Quinta do Lago.
            Acompanhamos cada passo, da primeira visita à decisão.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a href="/imoveis/" class="btn btn-champagne">
              Ver todos os imóveis
            </a>
            <a href="#vender" class="btn bg-white text-forest hover:bg-paper-2">
              Quero vender
            </a>
          </div>
        </div>

        <div class="hero-deck mt-8 lg:mt-0 lg:w-[22rem] lg:shrink-0" data-deck>
          <div class="hero-cards hidden lg:grid">
            {slides.map((slide, i) =>
              slide.property ? (
                <article class="hero-card" data-slide={i} inert={i !== 0} aria-hidden={i !== 0}>
                  <p class="hero-card-kicker">
                    {propertyTypeLabels[slide.property.propertyType]}
                    {slide.property.condition === 'new' && <span class="card-flag">Novo</span>}
                  </p>
                  <h2 class="mt-2 font-display text-lg leading-tight">{slide.property.title}</h2>
                  <p class="mt-1 flex items-center gap-1.5 text-xs text-white/80">
                    <Icon name="pin" class="size-3.5" />
                    {[slide.property.locality, zones[slide.property.zone].name]
                      .filter(Boolean)
                      .join(', ')}
                  </p>
                  <p class="mt-3 font-display text-[1.75rem] leading-none">
                    {formatPrice(slide.property.price)}
                  </p>
                  <ul class="mt-2.5 flex gap-3.5 text-xs text-white/85">
                    <li class="flex items-center gap-1.5">
                      <Icon name="bed" class="size-3.5" /> {slide.property.bedrooms}
                    </li>
                    <li class="flex items-center gap-1.5">
                      <Icon name="bath" class="size-3.5" /> {slide.property.bathrooms}
                    </li>
                    <li class="flex items-center gap-1.5">
                      <Icon name="area" class="size-3.5" /> {slide.property.usableArea} m²
                    </li>
                  </ul>
                  <a
                    href={`/imoveis/${slide.property.slug}/`}
                    class="hero-card-photo group mt-4 [@media(max-height:760px)]:hidden"
                    aria-label={`Ver imóvel: ${slide.property.title}`}
                  >
                    <img
                      src={slide.property.images[1] ?? slide.property.images[0]}
                      alt=""
                      class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                      loading="lazy"
                      referrerpolicy="no-referrer"
                    />
                    <span class="hero-card-go">
                      <Icon name="arrowUpRight" class="size-5" />
                    </span>
                  </a>
                </article>
              ) : null,
            )}
          </div>
          <div class="hero-controls" role="group" aria-label="Imagens do topo">
            {slides.map((_, i) => (
              <button
                type="button"
                class="hero-dot"
                data-dot={i}
                aria-label={`Ver imagem ${i + 1} de ${slides.length}`}
                aria-current={i === 0 ? 'true' : 'false'}
              >
                <span></span>
              </button>
            ))}
            <button
              type="button"
              class="hero-pause"
              data-pause
              aria-label="Pausar a rotação das imagens"
            >
              <Icon name="pause" class="hero-ic-pause size-4" />
              <Icon name="play" class="hero-ic-play size-4" />
            </button>
          </div>
        </div>
      </div>

      <div
        class="relative z-10 mx-auto pb-3"
        style="width: min(100% - 3rem, var(--page-w) - 1.5rem)"
      >
        <div class="glass-panel">
          <SearchBar />
        </div>
      </div>

      <div class="hero-strip" aria-hidden="true">
        <i class="hs-l"></i>
        <i class="hs-m"></i>
        <i class="hs-r"></i>
      </div>
    </div>
  </section>

  <!-- Featured: carousel that starts on the page column and bleeds off the right edge -->
  <section class="pt-14" aria-labelledby="destaques">
    <div class="container-x flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
      <div class="max-w-xl">
        <h2 id="destaques" class="font-display text-3xl text-forest sm:text-4xl">
          Imóveis em destaque
        </h2>
        <p class="mt-3 text-ink/70">
          Uma seleção dos imóveis que a nossa equipa recomenda neste momento.
        </p>
      </div>
      <div class="flex items-center gap-5">
        <a href="/imoveis/" class="feat-all">
          Ver todos os imóveis <Icon name="arrowRight" class="size-4" />
        </a>
        <div class="hidden gap-2 sm:flex">
          <button type="button" class="feat-nav" data-feat-prev aria-label="Imóveis anteriores">
            <Icon name="chevronLeft" class="size-5" />
          </button>
          <button type="button" class="feat-nav" data-feat-next aria-label="Imóveis seguintes">
            <Icon name="chevronRight" class="size-5" />
          </button>
        </div>
      </div>
    </div>
    <div class="container-x">
      <div class="feat-track mt-7" data-feat-track data-reveal-group>
        {featured.map((p, i) => (
          <div class="feat-item reveal" style={`--i: ${i % 4}`}>
            <PropertyCard property={p} eager={i < 4} />
          </div>
        ))}
      </div>
      <div class="feat-bar" aria-hidden="true">
        <span data-feat-bar></span>
      </div>
    </div>
  </section>

  <!-- Zones: index list on the left, one large editorial highlight that bleeds to the right edge -->
  <section
    id="zonas"
    class="zones-section on-dark mt-20 overflow-x-clip"
    aria-labelledby="zonas-titulo"
  >
    <div class="zones-band">
      <div class:list={['grid', mainHighlight && 'lg:grid-cols-2']}>
        <div class="zones-intro rise flex flex-col pb-10 lg:py-0">
          <p class="zone-eyebrow">Algarve</p>
          <h2 id="zonas-titulo" class="mt-3 font-display text-3xl text-white sm:text-4xl">
            Explore por zona
          </h2>
          <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:flex-1 lg:grid-rows-2">
            {zoneTiles.map((t) => (
              <a
                href={`/imoveis/?zona=${t.id}`}
                class="group relative isolate flex aspect-square flex-col justify-end overflow-hidden p-4 lg:aspect-auto text-white"
              >
                {t.image ? (
                  <>
                    <img
                      src={t.image}
                      alt=""
                      class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                      referrerpolicy="no-referrer"
                    />
                    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-forest/90 via-forest/35 to-forest/5" />
                  </>
                ) : (
                  <div class="zone-plain absolute inset-0 -z-10 transition-transform duration-700 group-hover:scale-105" />
                )}
                <span class="zone-go">
                  <span class="zone-go-text">Ver propriedades nesta zona</span>
                  <span class="zone-go-arrow">
                    <Icon name="arrowUpRight" class="size-5" />
                  </span>
                </span>
                <h3 class="font-display text-xl">{zones[t.id].name}</h3>
                <span class="mt-2 block h-px w-8 bg-white/70 transition-[width,background-color] duration-500 group-hover:w-16 group-hover:bg-lime" />
              </a>
            ))}
          </div>
        </div>

        {mainHighlight && (
          <div class="zones-photo relative isolate min-h-[30rem] overflow-hidden rounded-lg">
            <img
              src={mainHighlight.image}
              alt={mainHighlight.imageAlt}
              class="absolute inset-0 -z-20 size-full object-cover"
              loading="lazy"
              referrerpolicy="no-referrer"
            />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-forest/95 via-forest/55 to-forest/5" />

            <div class="flex h-full min-h-[30rem] flex-col justify-end gap-6 p-6 xl:flex-row xl:items-end xl:justify-between lg:p-10">
              <a href={mainHighlight.href} class="group max-w-md">
                <span class="card-tag inline-block bg-white">{mainHighlight.label}</span>
                <span class="mt-4 block font-display text-3xl leading-tight text-white sm:text-4xl">
                  {mainHighlight.title}
                </span>
                <span class="mt-3 block text-sm leading-relaxed text-white/80">
                  {mainHighlight.text}
                </span>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-white group-hover:text-lime">
                  Ver empreendimento <Icon name="arrowRight" class="size-4" />
                </span>
              </a>

              {otherHighlights.length > 0 && (
                <div class="flex flex-col gap-3 xl:w-72">
                  {otherHighlights.slice(0, 2).map((h) => (
                    <a href={h.href} class="zone-mini group">
                      <img
                        src={h.image}
                        alt={h.imageAlt}
                        class="size-16 shrink-0 rounded-md object-cover"
                        loading="lazy"
                        referrerpolicy="no-referrer"
                      />
                      <span class="min-w-0">
                        <span class="block text-xs text-white/65">{h.label}</span>
                        <span class="mt-0.5 block font-display text-base leading-snug text-white">
                          {h.title}
                        </span>
                      </span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- About: text + CTA, tall photo and pillars (home page "about us"), then the offices -->
  <section id="sobre" class="container-x mt-20 lg:mt-24" aria-labelledby="sobre-titulo">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-20">
      <div class="rise flex flex-col items-start justify-between gap-8">
        <h2 id="sobre-titulo" class="font-display text-4xl leading-[1.05] text-forest sm:text-5xl">
          Somos daqui. Sentimos o mercado como poucos.
        </h2>
        <!-- Office photos. TODO: placeholders until the client sends photos of the offices. -->
        <div class="office-photos" data-count={officePhotos.length}>
          {officePhotos.map((ph) => (
            <figure class="office-photo">
              {ph.src ? (
                <img src={ph.src} alt={ph.alt} loading="lazy" />
              ) : (
                <div class="office-ph" role="img" aria-label={ph.alt}>
                  <i aria-hidden="true"></i>
                  <img src={logoWhiteImage} alt="" loading="lazy" />
                </div>
              )}
            </figure>
          ))}
        </div>
        <a href="#contacto" class="btn btn-dark">
          Falar com a equipa
        </a>
      </div>
      <div class="rise about-copy grid max-w-[40.5rem] content-start gap-4 text-left text-base leading-relaxed text-ink/80 md:text-justify sm:text-[1.0625rem]">
        <!-- TODO: provisional SEO copy (PT). To be reviewed with the client; EN/FR versions pending. -->
        <p>
          A JPP Properties é uma imobiliária no Algarve (licença AMI {AMI}), especializada na
          compra, venda e arrendamento de apartamentos, moradias e terrenos em{' '}
          {aboutZones.map((z, i) => (
            <>
              <a href={`/imoveis/?zona=${z.id}`}>{z.name}</a>
              {i < aboutZones.length - 2 ? ', ' : i === aboutZones.length - 2 ? ' e ' : '.'}
            </>
          ))}
        </p>
        <p>
          Dos condomínios e campos de golfe às marinas e praias, ajudamos quem quer viver, investir
          ou ter uma casa de férias no Algarve a encontrar o imóvel certo, com informação clara e
          atualizada sobre cada zona.
        </p>
        <p>
          Conhecemos cada zona por dentro e acompanhamos cada passo, da primeira visita à escritura,
          para que decida com segurança, seja para comprar casa no Algarve, vender o seu imóvel ou
          encontrar um arrendamento.
        </p>
      </div>
    </div>

    <ul class="about-pillars rise mt-16 grid border-y border-line md:grid-cols-3">
      {(
        [
          {
            icon: 'pinMap',
            title: 'Conhecimento local',
            text: 'Somos daqui. Trabalhamos todos os dias nas zonas onde vive quem compra e quem vende.',
          },
          {
            icon: 'clientCare',
            title: 'Atenção a cada cliente',
            text: 'Damos prioridade ao que cada pessoa quer e precisa, da primeira visita à decisão.',
          },
          {
            icon: 'houseKey',
            title: 'As melhores opções',
            text: 'Apresentamos as melhores opções de negócio para viver, arrendar ou investir.',
          },
        ] as const
      ).map((p, i) => (
        <li class="about-pillar group relative flex gap-5 px-0 py-8 md:px-8 md:first:pl-0 md:last:pr-0">
          <span class="about-pillar-icon">
            <Icon name={p.icon} class="size-7" />
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-xl text-forest">{p.title}</h3>
              <span class="about-pillar-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <!-- Team: full width, four per view, carousel when the team grows (the section keeps its height). -->
    <div
      id="equipa"
      class="mt-20 grid gap-8 lg:mt-24 lg:grid-cols-[minmax(0,19rem)_minmax(0,1fr)] lg:gap-14"
    >
      <div class="rise flex flex-col justify-between gap-8 lg:gap-0">
        <div>
          <h2 id="equipa-titulo" class="font-display text-3xl text-forest sm:text-4xl">
            A nossa equipa
          </h2>
          <p class="mt-3 text-ink/70">
            Fale diretamente com quem o vai acompanhar, da primeira visita à escritura.
          </p>
        </div>
        <div class="team-nav" data-team-nav hidden>
          <button type="button" class="feat-nav" data-team-prev aria-label="Agentes anteriores">
            <Icon name="chevronLeft" class="size-5" />
          </button>
          <button type="button" class="feat-nav" data-team-next aria-label="Agentes seguintes">
            <Icon name="chevronRight" class="size-5" />
          </button>
          <div class="team-bar" aria-hidden="true">
            <span data-team-bar></span>
          </div>
        </div>
      </div>
      <div class="rise min-w-0">
        <ul
          class="team-grid"
          aria-label="A nossa equipa"
          data-team-track
          style={`--n-sm: ${Math.min(team.length, 2)}; --n-md: ${Math.min(team.length, 3)}; --n-lg: ${Math.min(team.length, 3)}`}
        >
          {team.map((a) => (
            <li class="team-card">
              <div class="team-photo">
                {a.photo ? (
                  <img src={a.photo} alt={a.name} loading="lazy" />
                ) : (
                  <div class="team-ph" aria-hidden="true">
                    <i></i>
                    <img src={logoWhiteImage} alt="" loading="lazy" />
                  </div>
                )}
                <div class="team-name">
                  <h3 class="font-display text-xl leading-tight">{a.name}</h3>
                  <p class="mt-1 text-sm text-white/75">{a.role}</p>
                </div>
              </div>
              <div class="team-contacts">
                {a.phone && (
                  <a href={`tel:${a.phone.tel}`} aria-label={`Ligar a ${a.name}`}>
                    <Icon name="phone" class="size-4" />
                  </a>
                )}
                {a.whatsapp && (
                  <a
                    href={`https://wa.me/${a.whatsapp}`}
                    target="_blank"
                    rel="noopener"
                    aria-label={`WhatsApp de ${a.name}`}
                  >
                    <Icon name="whatsapp" class="size-4" />
                  </a>
                )}
                {a.email && (
                  <a href={`mailto:${a.email}`} aria-label={`Enviar email a ${a.name}`}>
                    <Icon name="mail" class="size-4" />
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 grid gap-4">
      {offices.map((o) => (
        <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)]">
          <article class="flex min-h-64 flex-col justify-between rounded-3xl bg-paper-2 p-7">
            <div>
              <span class="grid size-11 place-items-center rounded-xl bg-white text-olive">
                <Icon name="pin" class="size-5" />
              </span>
              <h3 class="mt-5 font-display text-2xl text-forest">Escritório de {o.name}</h3>
              <address class="mt-2 text-sm not-italic leading-relaxed text-muted">
                {o.address.map((line) => (
                  <div>{line}</div>
                ))}
              </address>
            </div>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={`tel:${o.phones[0].tel}`} class="btn btn-dark">
                <Icon name="phone" class="size-4" /> Ligar
              </a>
              <a href={o.mapUrl} class="btn btn-ghost" target="_blank" rel="noopener">
                Ver no mapa
              </a>
            </div>
          </article>
          <div class="min-h-72 overflow-hidden rounded-3xl bg-paper-2">
            <iframe
              title={`Mapa: Escritório de ${o.name}`}
              src={`https://www.google.com/maps?q=${encodeURIComponent(`JPP Properties, ${o.address.join(', ')}`)}&hl=pt-PT&t=h&z=16&output=embed`}
              class="size-full min-h-72 border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Sell / buy request form (e-mailed to the team) -->
  <LeadForm />

  <!-- Contact -->
  <section
    id="contacto"
    class="container-x mt-28 grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16"
    aria-labelledby="contacto-titulo"
  >
    <div>
      <h2 id="contacto-titulo" class="font-display text-3xl text-forest sm:text-4xl">
        Fale connosco
      </h2>
      <p class="mt-4 max-w-md text-ink/80">
        Ligue, escreva ou visite o nosso escritório. Respondemos o mais depressa possível.
      </p>
      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        {offices.map((o) => (
          <div>
            <h3 class="font-display text-xl text-forest">{o.name}</h3>
            <address class="mt-2 text-sm not-italic leading-relaxed text-ink/80">
              {o.address.map((l) => (
                <div>{l}</div>
              ))}
            </address>
            <ul class="mt-3 space-y-2 text-sm">
              {o.phones.map((p) => (
                <li>
                  <a href={`tel:${p.tel}`} class="font-semibold text-forest hover:text-olive">
                    {p.label}
                  </a>
                  <span class="block text-xs text-muted">({p.note})</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <a
        href={`mailto:${email}`}
        class="mt-8 inline-flex items-center gap-2 font-semibold text-olive hover:text-forest"
      >
        <Icon name="mail" class="size-5" /> {email}
      </a>
    </div>
    <div class="rounded-[2rem] border border-line bg-white p-6 sm:p-8">
      <ContactForm idPrefix="home" />
    </div>
  </section>
</SiteLayout>

<script>
  // Hero slideshow: crossfade between photos, with the matching listing card.
  // Keeps rotating while people use the hero or the search box. It only pauses when the tab is
  // hidden or on request (pause button), and never autoplays for people who prefer reduced motion.
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const slides = [...document.querySelectorAll<HTMLElement>('.hero-slide')];
  const cards = [...document.querySelectorAll<HTMLElement>('.hero-card')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('.hero-dot')];
  const pauseBtn = document.querySelector<HTMLButtonElement>('[data-pause]');
  const hero = document.querySelector<HTMLElement>('.hero-shape');

  if (media && slides.length > 1 && hero) {
    const INTERVAL = 6500;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = 0;
    let userPaused = reduce;
    document.documentElement.style.setProperty('--hero-interval', `${INTERVAL}ms`);

    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === index));
      cards.forEach((c) => {
        const on = Number(c.dataset.slide) === index;
        c.toggleAttribute('data-active', on);
        c.inert = !on;
        c.setAttribute('aria-hidden', String(!on));
      });
      dots.forEach((d, k) => d.setAttribute('aria-current', String(k === index)));
      restart();
    };
    const restart = () => {
      clearTimeout(timer);
      dots.forEach((d) => d.classList.remove('is-run'));
      const running = !userPaused && !document.hidden;
      if (!running) return;
      void dots[index]?.offsetWidth; // restart the progress bar animation
      dots[index]?.classList.add('is-run');
      timer = window.setTimeout(() => show(index + 1), INTERVAL);
    };
    const setPaused = (value: boolean) => {
      userPaused = value;
      pauseBtn?.setAttribute(
        'aria-label',
        value ? 'Retomar a rotação das imagens' : 'Pausar a rotação das imagens',
      );
      pauseBtn?.toggleAttribute('data-paused', value);
      restart();
    };

    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
    pauseBtn?.addEventListener('click', () => setPaused(!userPaused));
    document.addEventListener('visibilitychange', restart);
    setPaused(userPaused);
    show(0);
  }
</script>
<script>
  // Team carousel: cards keep their size and the row scrolls, so the section never grows when the team does.
  // Controls only appear when there is more than fits.
  const teamTrack = document.querySelector<HTMLElement>('[data-team-track]');
  if (teamTrack) {
    const nav = document.querySelector<HTMLElement>('[data-team-nav]');
    const prev = document.querySelector<HTMLButtonElement>('[data-team-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-team-next]');
    const bar = document.querySelector<HTMLElement>('[data-team-bar]');
    const step = () => {
      const card = teamTrack.querySelector<HTMLElement>('.team-card');
      return card ? card.offsetWidth + 16 : teamTrack.clientWidth;
    };
    const sync = () => {
      const max = teamTrack.scrollWidth - teamTrack.clientWidth;
      if (nav) nav.hidden = max <= 4;
      const share = Math.min(teamTrack.clientWidth / teamTrack.scrollWidth, 1);
      const pos = max > 0 ? teamTrack.scrollLeft / max : 0;
      if (bar) {
        bar.style.width = `${share * 100}%`;
        bar.style.transform = `translateX(${pos * (1 / share - 1) * 100}%)`;
      }
      if (prev) prev.disabled = pos <= 0.01;
      if (next) next.disabled = pos >= 0.99;
    };
    prev?.addEventListener('click', () =>
      teamTrack.scrollBy({ left: -step(), behavior: 'smooth' }),
    );
    next?.addEventListener('click', () => teamTrack.scrollBy({ left: step(), behavior: 'smooth' }));
    teamTrack.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>

<script>
  // Hero deck: a gentle tilt that follows the mouse (fine pointers only, never with reduced motion).
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  if (
    deck &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    deck.addEventListener('pointermove', (e) => {
      const r = deck.getBoundingClientRect();
      deck.style.setProperty(
        '--ry',
        `${(((e.clientX - r.left) / r.width - 0.5) * 5).toFixed(2)}deg`,
      );
      deck.style.setProperty(
        '--rx',
        `${((0.5 - (e.clientY - r.top) / r.height) * 4).toFixed(2)}deg`,
      );
    });
    deck.addEventListener('pointerleave', () => {
      deck.style.removeProperty('--rx');
      deck.style.removeProperty('--ry');
    });
  }
</script>

<script>
  // Featured carousel: the arrows move it one card at a time.
  const featTrack = document.querySelector<HTMLElement>('[data-feat-track]');
  if (featTrack) {
    const step = () => {
      const item = featTrack.querySelector<HTMLElement>('.feat-item');
      return item ? item.offsetWidth + 24 : featTrack.clientWidth;
    };
    document
      .querySelector('[data-feat-prev]')
      ?.addEventListener('click', () => featTrack.scrollBy({ left: -step(), behavior: 'smooth' }));
    document
      .querySelector('[data-feat-next]')
      ?.addEventListener('click', () => featTrack.scrollBy({ left: step(), behavior: 'smooth' }));

    // Position bar: its length is the visible share of the row, its offset follows the scroll.
    const bar = document.querySelector<HTMLElement>('[data-feat-bar]');
    const prev = document.querySelector<HTMLButtonElement>('[data-feat-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-feat-next]');
    const syncBar = () => {
      const max = featTrack.scrollWidth - featTrack.clientWidth;
      const share = featTrack.clientWidth / featTrack.scrollWidth;
      const pos = max > 0 ? featTrack.scrollLeft / max : 0;
      if (bar) {
        bar.style.width = `${Math.min(share, 1) * 100}%`;
        bar.style.transform = `translateX(${pos * (1 / Math.min(share, 1) - 1) * 100}%)`;
      }
      if (prev) prev.disabled = pos <= 0.01;
      if (next) next.disabled = max <= 0 || pos >= 0.99;
    };
    featTrack.addEventListener('scroll', syncBar, { passive: true });
    window.addEventListener('resize', syncBar);
    syncBar();
  }
</script>

<script>
  // Cards rise in one after another (left to right) the first time they scroll into view.
  const items = document.querySelectorAll<HTMLElement>('[data-reveal-group] .reveal, .rise');
  if (items.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }),
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('is-in'));
  }
</script>
