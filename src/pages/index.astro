---
import SiteLayout from '../layouts/SiteLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import PropertyCard from '../components/PropertyCard.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import {
  formatPrice,
  heroImage,
  visibleProperties as properties,
  zones,
  type ZoneId,
} from '../data/properties';
import { featuredProperties, heroSlides } from '../lib/catalog';
import { sideHighlights } from '../data/home';
import { AMI, offices, email } from '../lib/site';

const featured = featuredProperties();
const slides = heroSlides();
const [mainHighlight, ...otherHighlights] = sideHighlights;
const photo = (slug: string) => properties.find((p) => p.slug === slug)!.images[0];

// Zone photos used on the tiles. TODO: in production each zone document has its own photo (Sanity).
const zoneImages: Partial<Record<ZoneId, string>> = {
  vilamoura: photo('casuarinas-residences-vilamoura'),
  quarteira: photo('t2-perto-da-praia-quarteira'),
};
const zoneTiles = (Object.keys(zones) as ZoneId[]).map((id) => ({ id, image: zoneImages[id] }));
---

<SiteLayout
  title="JPP Properties | Imóveis no Algarve"
  description="Apartamentos e moradias em Vilamoura, Quarteira, Vale do Lobo e Quinta do Lago. JPP Properties, AMI 9361."
  route="home"
  padTop={false}
>
  <!-- Hero: full-bleed rotating photos, rounded bottom corners and a hanging tab that holds the search box -->
  <section>
    <div class="hero-shape relative isolate z-20 flex min-h-[clamp(620px,78svh,820px)] flex-col justify-end">
      <div class="absolute inset-0 -z-20 overflow-hidden" data-hero-media>
        {slides.map((slide, i) => (
          <img
            src={slide.image}
            alt={slide.alt}
            class:list={['hero-slide size-full object-cover', i === 0 && 'is-active']}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            referrerpolicy="no-referrer"
          />
        ))}
      </div>
      <div class="hero-shade absolute inset-0 -z-10"></div>

      <div class="container-x pb-8 pt-32 text-white lg:flex lg:items-end lg:justify-between lg:gap-10">
        <div class="hero-copy">
          <h1 class="max-w-4xl font-display text-[clamp(2rem,4.2vw,3.5rem)] leading-[1]">
            Encontre a sua casa no Algarve.
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/90 [@media(max-height:740px)]:hidden">
            Apartamentos e moradias em Vilamoura, Quarteira, Vale do Lobo e Quinta do Lago.
            Acompanhamos cada passo, da primeira visita à decisão.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a href="/imoveis/" class="btn btn-lime">
              Ver todos os imóveis
            </a>
            <a href="#vender" class="btn bg-white text-forest hover:bg-paper-2">
              Quero vender
            </a>
          </div>
        </div>

        <div class="mt-8 lg:mt-0 lg:w-[21rem] lg:shrink-0">
          <div class="hero-cards hidden lg:grid">
            {slides.map((slide, i) =>
              slide.property ? (
                <article class="hero-card" data-slide={i} inert={i !== 0} aria-hidden={i !== 0}>
                  <h2 class="font-display text-xl leading-tight">{slide.property.title}</h2>
                  <p class="mt-1 flex items-center gap-1.5 text-sm text-white/80">
                    <Icon name="pin" class="size-4" />
                    {[slide.property.locality, zones[slide.property.zone].name]
                      .filter(Boolean)
                      .join(', ')}
                  </p>
                  <p class="mt-3 font-display text-3xl leading-none">
                    {formatPrice(slide.property.price)}
                  </p>
                  <ul class="mt-3 flex gap-4 text-sm text-white/85">
                    <li class="flex items-center gap-1.5">
                      <Icon name="bed" class="size-4" /> {slide.property.bedrooms}
                    </li>
                    <li class="flex items-center gap-1.5">
                      <Icon name="bath" class="size-4" /> {slide.property.bathrooms}
                    </li>
                    <li class="flex items-center gap-1.5">
                      <Icon name="area" class="size-4" /> {slide.property.usableArea} m²
                    </li>
                  </ul>
                  <a
                    href={`/imoveis/${slide.property.slug}/`}
                    class="btn mt-4 w-full rounded-none bg-white text-forest hover:bg-paper-2"
                  >
                    Ver imóvel
                  </a>
                </article>
              ) : null,
            )}
          </div>
          <div class="hero-controls" role="group" aria-label="Imagens do topo">
            {slides.map((_, i) => (
              <button
                type="button"
                class="hero-dot"
                data-dot={i}
                aria-label={`Ver imagem ${i + 1} de ${slides.length}`}
                aria-current={i === 0 ? 'true' : 'false'}
              >
                <span></span>
              </button>
            ))}
            <button
              type="button"
              class="hero-pause"
              data-pause
              aria-label="Pausar a rotação das imagens"
            >
              <Icon name="pause" class="hero-ic-pause size-4" />
              <Icon name="play" class="hero-ic-play size-4" />
            </button>
          </div>
        </div>
      </div>

      <div
        class="relative z-10 mx-auto pb-3"
        style="width: min(100% - 3rem, var(--page-w) - 1.5rem)"
      >
        <div class="glass-panel">
          <SearchBar />
        </div>
      </div>

      <div class="hero-strip" aria-hidden="true">
        <i class="hs-l"></i>
        <i class="hs-m"></i>
        <i class="hs-r"></i>
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="container-x pt-24" aria-labelledby="destaques">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="destaques" class="font-display text-3xl text-forest sm:text-4xl">
        Imóveis em destaque
      </h2>
      <a
        href="/imoveis/"
        class="inline-flex items-center gap-2 font-semibold text-olive hover:text-forest"
      >
        Ver todos <Icon name="arrowRight" class="size-5" />
      </a>
    </div>
    <!-- Aligned grid: equal-height cards; they rise in one after another along each row -->
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-reveal-group>
      {featured.map((p, i) => (
        <div class="reveal h-full" style={`--i: ${i % 4}`}>
          <PropertyCard property={p} eager={i < 4} />
        </div>
      ))}
    </div>
  </section>

  <!-- Zones: even grid of photo tiles, name + short rule + number of listings -->
  <section id="zonas" class="on-dark mt-20 bg-forest pb-24 pt-14" aria-labelledby="zonas-titulo">
    <div class="container-x">
      <h2 id="zonas-titulo" class="font-display text-3xl text-white sm:text-4xl">
        Explore por zona
      </h2>
      <div class:list={['mt-10 grid gap-6', mainHighlight && 'lg:grid-cols-[1fr_24.5rem]']}>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {zoneTiles.map((t) => (
            <a
              href={`/imoveis/?zona=${t.id}`}
              class="group relative isolate flex aspect-[4/3] flex-col justify-end lg:aspect-square overflow-hidden p-6 text-white"
            >
              {t.image ? (
                <>
                  <img
                    src={t.image}
                    alt=""
                    class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                  />
                  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-forest/90 via-forest/35 to-forest/5" />
                </>
              ) : (
                <div class="absolute inset-0 -z-10 bg-gradient-to-br from-olive to-forest-2 ring-1 ring-inset ring-white/10 transition-transform duration-700 group-hover:scale-105" />
              )}
              <span class="absolute right-9 top-4 grid size-9 place-items-center bg-white/15 backdrop-blur transition-colors group-hover:bg-lime group-hover:text-forest">
                <Icon name="arrowUpRight" class="size-5" />
              </span>
              <h3 class="font-display text-2xl">{zones[t.id].name}</h3>
              <span class="mt-3 block h-px w-8 bg-white/70 transition-all duration-500 group-hover:w-16 group-hover:bg-lime" />
            </a>
          ))}
        </div>

        <!-- Side panel: free-form highlights (image + text), editable by the team -->
        {mainHighlight && (
          <aside
            class="flex flex-col rounded-lg bg-white p-5 lg:relative lg:z-10 lg:-my-12 lg:-ml-12 lg:shadow-[0_34px_70px_-34px_rgba(24,35,26,0.55)]"
            aria-label="Destaques"
          >
            <a href={mainHighlight.href} class="group flex min-h-0 flex-1 flex-col">
              <span class="relative block min-h-40 flex-1 overflow-hidden rounded-md">
                <img
                  src={mainHighlight.image}
                  alt={mainHighlight.imageAlt}
                  class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                  referrerpolicy="no-referrer"
                />
              </span>
              <span class="mt-5 block text-xs font-medium text-olive">{mainHighlight.label}</span>
              <span class="mt-1 block font-display text-2xl leading-tight text-forest">
                {mainHighlight.title}
              </span>
              <span class="mt-2 line-clamp-2 block text-sm leading-relaxed text-muted">
                {mainHighlight.text}
              </span>
            </a>

            {otherHighlights.length > 0 && (
              <>
                <hr class="my-4 border-olive/40" />
                <div class="grid grid-cols-2 gap-4">
                  {otherHighlights.slice(0, 2).map((h) => (
                    <a href={h.href} class="group block">
                      <span class="block overflow-hidden rounded-md">
                        <img
                          src={h.image}
                          alt={h.imageAlt}
                          class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                          loading="lazy"
                          referrerpolicy="no-referrer"
                        />
                      </span>
                      <span class="mt-3 block text-xs font-medium text-olive">{h.label}</span>
                      <span class="mt-1 block font-display text-base leading-snug text-forest">
                        {h.title}
                      </span>
                    </a>
                  ))}
                </div>
              </>
            )}
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- About: text + CTA, tall photo and pillars (home page "about us"), then the two offices -->
  <section id="sobre" class="container-x mt-28" aria-labelledby="sobre-titulo">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_0.95fr_1fr] lg:gap-14">
      <div>
        <h2 id="sobre-titulo" class="font-display text-3xl text-forest sm:text-4xl">
          Somos daqui. Sentimos o mercado como poucos.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink/80">
          A JPP Properties é uma agência imobiliária que trabalha sobretudo em Vilamoura, Quarteira,
          Vilasol, Vale do Lobo, Quinta do Lago e em toda a zona central do Algarve.
        </p>
        <p class="mt-4 leading-relaxed text-muted">
          Com muitos anos de experiência, apresentamos as melhores opções de negócio, dando
          prioridade ao que cada cliente quer e precisa.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="#contacto" class="btn btn-dark">
            Falar com a equipa
          </a>
          <span class="rounded-md bg-paper-2 px-3 py-2 text-sm font-semibold text-forest">
            Licença AMI {AMI}
          </span>
        </div>
      </div>

      <div class="mx-auto w-full max-w-sm lg:max-w-none">
        <img
          src={heroImage}
          alt="Piscina rodeada de palmeiras, com o campo de golfe ao fundo"
          class="aspect-[4/5] w-full rounded-3xl object-cover"
          loading="lazy"
          referrerpolicy="no-referrer"
        />
      </div>

      <ul class="divide-y divide-line border-y border-line">
        {[
          {
            icon: 'pin',
            title: 'Conhecimento local',
            text: 'Somos daqui. Trabalhamos todos os dias nas zonas onde vive quem compra e quem vende.',
          },
          {
            icon: 'user',
            title: 'Atenção a cada cliente',
            text: 'Damos prioridade ao que cada pessoa quer e precisa, da primeira visita à decisão.',
          },
          {
            icon: 'home',
            title: 'As melhores opções',
            text: 'Apresentamos as melhores opções de negócio para viver, arrendar ou investir.',
          },
        ].map((p) => (
          <li class="flex gap-4 py-6">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-paper-2 text-olive">
              <Icon name={p.icon as 'pin' | 'user' | 'home'} class="size-5" />
            </span>
            <div>
              <h3 class="font-display text-xl text-forest">{p.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {offices.map((o) => (
        <article class="flex min-h-64 flex-col justify-between rounded-3xl bg-paper-2 p-7">
          <div>
            <span class="grid size-11 place-items-center rounded-xl bg-white text-olive">
              <Icon name="pin" class="size-5" />
            </span>
            <h3 class="mt-5 font-display text-2xl text-forest">Escritório de {o.name}</h3>
            <address class="mt-2 text-sm not-italic leading-relaxed text-muted">
              {o.address.map((line) => (
                <div>{line}</div>
              ))}
            </address>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`tel:${o.phones[0].tel}`} class="btn btn-dark">
              <Icon name="phone" class="size-4" /> Ligar
            </a>
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(o.address.join(', '))}`}
              class="btn btn-ghost"
              target="_blank"
              rel="noopener"
            >
              Ver no mapa
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Sell / request a property -->
  <section id="vender" class="on-dark container-x mt-24" aria-label="Vender ou pedir um imóvel">
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="flex flex-col justify-between rounded-[2rem] bg-forest p-8 text-white sm:p-12">
        <div>
          <h2 class="font-display text-3xl leading-tight sm:text-4xl">Quer vender o seu imóvel?</h2>
          <p class="mt-5 max-w-md text-white/80">
            Diga-nos onde fica e o que tem. Avaliamos o imóvel e propomos a melhor forma de o
            apresentar a quem procura.
          </p>
        </div>
        <a href="#contacto" class="btn btn-lime mt-10 self-start">
          Pedir avaliação
        </a>
      </div>
      <div class="flex flex-col justify-between rounded-[2rem] bg-olive p-8 text-white sm:p-12">
        <div>
          <h2 class="font-display text-3xl leading-tight sm:text-4xl">
            Não encontra o que procura?
          </h2>
          <p class="mt-5 max-w-md text-white/90">
            Descreva o imóvel ideal e procuramos por si, incluindo propriedades que ainda não estão
            no site.
          </p>
        </div>
        <a href="#contacto" class="btn mt-10 self-start bg-white text-forest hover:bg-paper">
          Pedir um imóvel
        </a>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section
    id="contacto"
    class="container-x mt-28 grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16"
    aria-labelledby="contacto-titulo"
  >
    <div>
      <h2 id="contacto-titulo" class="font-display text-3xl text-forest sm:text-4xl">
        Fale connosco
      </h2>
      <p class="mt-4 max-w-md text-ink/80">
        Ligue, escreva ou visite um dos nossos dois escritórios. Respondemos o mais depressa
        possível.
      </p>
      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        {offices.map((o) => (
          <div>
            <h3 class="font-display text-xl text-forest">{o.name}</h3>
            <address class="mt-2 text-sm not-italic leading-relaxed text-ink/80">
              {o.address.map((l) => (
                <div>{l}</div>
              ))}
            </address>
            <ul class="mt-3 space-y-2 text-sm">
              {o.phones.map((p) => (
                <li>
                  <a href={`tel:${p.tel}`} class="font-semibold text-forest hover:text-olive">
                    {p.label}
                  </a>
                  <span class="block text-xs text-muted">({p.note})</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <a
        href={`mailto:${email}`}
        class="mt-8 inline-flex items-center gap-2 font-semibold text-olive hover:text-forest"
      >
        <Icon name="mail" class="size-5" /> {email}
      </a>
    </div>
    <div class="rounded-[2rem] border border-line bg-white p-6 sm:p-8">
      <ContactForm idPrefix="home" />
    </div>
  </section>
</SiteLayout>

<script>
  // Hero slideshow: crossfade between photos, with the matching listing card.
  // Keeps rotating while people use the hero or the search box. It only pauses when the tab is
  // hidden or on request (pause button), and never autoplays for people who prefer reduced motion.
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const slides = [...document.querySelectorAll<HTMLElement>('.hero-slide')];
  const cards = [...document.querySelectorAll<HTMLElement>('.hero-card')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('.hero-dot')];
  const pauseBtn = document.querySelector<HTMLButtonElement>('[data-pause]');
  const hero = document.querySelector<HTMLElement>('.hero-shape');

  if (media && slides.length > 1 && hero) {
    const INTERVAL = 6500;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = 0;
    let userPaused = reduce;
    document.documentElement.style.setProperty('--hero-interval', `${INTERVAL}ms`);

    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === index));
      cards.forEach((c) => {
        const on = Number(c.dataset.slide) === index;
        c.toggleAttribute('data-active', on);
        c.inert = !on;
        c.setAttribute('aria-hidden', String(!on));
      });
      dots.forEach((d, k) => d.setAttribute('aria-current', String(k === index)));
      restart();
    };
    const restart = () => {
      clearTimeout(timer);
      dots.forEach((d) => d.classList.remove('is-run'));
      const running = !userPaused && !document.hidden;
      if (!running) return;
      void dots[index]?.offsetWidth; // restart the progress bar animation
      dots[index]?.classList.add('is-run');
      timer = window.setTimeout(() => show(index + 1), INTERVAL);
    };
    const setPaused = (value: boolean) => {
      userPaused = value;
      pauseBtn?.setAttribute(
        'aria-label',
        value ? 'Retomar a rotação das imagens' : 'Pausar a rotação das imagens',
      );
      pauseBtn?.toggleAttribute('data-paused', value);
      restart();
    };

    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
    pauseBtn?.addEventListener('click', () => setPaused(!userPaused));
    document.addEventListener('visibilitychange', restart);
    setPaused(userPaused);
    show(0);
  }
</script>

<script>
  // Cards rise in one after another (left to right) the first time they scroll into view.
  const items = document.querySelectorAll<HTMLElement>('[data-reveal-group] .reveal');
  if (items.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }),
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('is-in'));
  }
</script>
