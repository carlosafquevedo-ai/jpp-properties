---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileContactBar from '../components/MobileContactBar.astro';
import FloatingWidgets from '../components/FloatingWidgets.astro';
import DragScroll from '../components/DragScroll.astro';
import type { RouteKey } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  route?: RouteKey;
  /** Inner pages reserve space under the floating header. */
  padTop?: boolean;
}

const { title, description, route, padTop = true } = Astro.props;
---

<BaseLayout locale="pt" {title} {description} {route} noindex bodyClass="pb-14 lg:pb-0">
  <SiteHeader overHero={!padTop} />
  <main id="main" class:list={[padTop && 'pt-28']}>
    <slot />
  </main>
  <SiteFooter />
  <MobileContactBar />
  <FloatingWidgets />
  <DragScroll />
</BaseLayout>
