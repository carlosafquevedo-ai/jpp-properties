---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingWidgets from '../components/FloatingWidgets.astro';
import DragScroll from '../components/DragScroll.astro';
import SiteIntro from '../components/SiteIntro.astro';
import type { RouteKey } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  route?: RouteKey;
  /** Inner pages reserve space under the floating header. */
  padTop?: boolean;
  /** The entrance curtain (off where it would only delay the message, e.g. the 404 page). */
  intro?: boolean;
}

const { title, description, route, padTop = true, intro = true } = Astro.props;
---

<BaseLayout locale="pt" {title} {description} {route} noindex>
  {intro && <SiteIntro />}
  <SiteHeader overHero={!padTop} />
  <main id="main" class:list={[padTop && 'pt-28']}>
    <slot />
  </main>
  <SiteFooter />
  <FloatingWidgets />
  <DragScroll />
</BaseLayout>
