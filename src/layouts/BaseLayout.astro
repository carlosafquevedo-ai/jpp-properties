---
import '../styles/global.css';
import { alternateLinks, defaultLocale, type Locale, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { SITE_URL } from '../lib/site';

interface Props {
  locale: Locale;
  /** Route key for hreflang/canonical. Omit on prototype-only pages without translations. */
  route?: RouteKey;
  title: string;
  description: string;
  noindex?: boolean;
  bodyClass?: string;
  /** Share preview image (absolute URL or site path); falls back to the logo. */
  image?: string;
  /** Open Graph type: "website" or, for a listing, "product"/"article". */
  ogType?: string;
  /** Structured data (schema.org), printed as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const {
  locale,
  route,
  title,
  description,
  noindex = false,
  bodyClass = '',
  image = '/brand/logo-black.png',
  ogType = 'website',
  jsonLd,
} = Astro.props;
const ogImage = new URL(image, SITE_URL).href;
const t = useTranslations(locale);
const alternates = route ? alternateLinks(route) : [];
const canonical = route
  ? new URL(alternates.find((a) => a.locale === locale)!.href, SITE_URL).href
  : new URL(Astro.url.pathname, SITE_URL).href;
const xDefault = route
  ? new URL(alternates.find((a) => a.locale === defaultLocale)!.href, SITE_URL).href
  : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta name="theme-color" content="#ffffff" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.locale} href={new URL(a.href, SITE_URL).href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="JPP Properties" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_PT' : locale === 'en' ? 'en_GB' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class:list={['min-h-screen bg-paper text-ink antialiased', bodyClass]}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-white focus:px-4 focus:py-2"
    >
      {t('a11y.skipToContent')}
    </a>
    <slot />
  </body>
</html>
