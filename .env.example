# Names only. Never commit real values. Real values live in .env (local, git-ignored)
# and in the Cloudflare Pages environment variables.

# Sanity (project id and dataset are public; the token is not)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (email delivery for forms)
RESEND_API_KEY=
